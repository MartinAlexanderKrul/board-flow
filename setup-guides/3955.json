{
  "schemaVersion": 1,
  "gameId": 3955,
  "gameName": "BANG!",
  "version": 2,
  "provenance": {
    "origin": "BOARDFLOW",
    "author": "BoardFlow",
    "sources": [
      "BANG! rulebook (dV Giochi, via RulesPal)",
      "High Noon rules",
      "A Fistful of Cards rules",
      "BANG! Legends rules"
    ]
  },
  "players": {
    "min": 4,
    "max": 7
  },
  "modules": [
    {
      "id": "simple",
      "name": "Simplified (no book cards)",
      "note": "For your first few games."
    },
    {
      "id": "high-noon",
      "name": "High Noon",
      "bggId": 8269
    },
    {
      "id": "fistful",
      "name": "A Fistful of Cards",
      "bggId": 20237
    },
    {
      "id": "legends",
      "name": "BANG! Legends",
      "bggId": 401241,
      "note": "Legendary characters replace the base characters."
    }
  ],
  "sections": [
    {
      "id": "roles",
      "title": "Roles & characters",
      "steps": [
        {
          "id": "boards",
          "text": "Each player takes a playing board",
          "ref": "Preparation"
        },
        {
          "id": "roles",
          "text": "Role cards: {r}",
          "amounts": {
            "r": {
              "byPlayers": {
                "4": "1 Sheriff, 1 Renegade, 2 Outlaws",
                "5": "1 Sheriff, 1 Renegade, 2 Outlaws, 1 Deputy",
                "6": "1 Sheriff, 1 Renegade, 3 Outlaws, 1 Deputy",
                "7": "1 Sheriff, 1 Renegade, 3 Outlaws, 2 Deputies"
              }
            }
          },
          "ref": "Preparation"
        },
        {
          "id": "deal-roles",
          "text": "Shuffle and deal 1 role facedown each; the Sheriff reveals, everyone else keeps theirs secret",
          "ref": "Preparation"
        },
        {
          "id": "characters",
          "text": "Deal 1 character faceup each; announce names and abilities",
          "ref": "Preparation",
          "condition": {
            "notModules": [
              "legends"
            ]
          }
        },
        {
          "id": "bullets",
          "text": "Take as many bullets as your character shows; the Sheriff takes one extra",
          "ref": "Preparation"
        },
        {
          "id": "box",
          "text": "Box the remaining roles, boards and characters",
          "ref": "Preparation"
        },
        {
          "id": "legend-chars",
          "text": "Shuffle the legendary characters; deal each player one from the bottom, normal side up",
          "condition": {
            "modules": [
              "legends"
            ]
          },
          "ref": "Legends: Setup"
        },
        {
          "id": "fame",
          "text": "Each player takes a set of 5 Fame tokens of one color",
          "condition": {
            "modules": [
              "legends"
            ]
          },
          "ref": "Legends: Setup"
        }
      ]
    },
    {
      "id": "cards",
      "title": "Cards",
      "steps": [
        {
          "id": "simple",
          "text": "Remove all cards with the book symbol",
          "condition": {
            "modules": [
              "simple"
            ]
          },
          "ref": "Preparation"
        },
        {
          "id": "deal",
          "text": "Shuffle the playing cards; deal each player as many cards as their bullets",
          "ref": "Preparation",
          "condition": {
            "notModules": [
              "legends"
            ]
          }
        },
        {
          "id": "draw",
          "text": "Draw pile facedown in the middle, room for a discard pile",
          "ref": "Preparation"
        },
        {
          "id": "legend-hands",
          "text": "Deal {n} cards each, whatever the bullets (Sheriff too); 6th and 7th players get 5",
          "amounts": {
            "n": 4
          },
          "condition": {
            "modules": [
              "legends"
            ]
          },
          "ref": "Legends: Setup"
        },
        {
          "id": "feats",
          "text": "Shuffle the Feat deck facedown by the draw pile; reveal 1 Feat beside it",
          "condition": {
            "modules": [
              "legends"
            ]
          },
          "ref": "Legends: Setup"
        },
        {
          "id": "high-noon",
          "text": "Sheriff shuffles the High Noon cards facedown, puts the High Noon card on top, then turns the stack faceup by them",
          "condition": {
            "modules": [
              "high-noon"
            ]
          },
          "ref": "High Noon rules"
        },
        {
          "id": "fistful",
          "text": "Sheriff shuffles the Fistful of Cards facedown, puts the A Fistful of Cards card on top, then turns the stack faceup by them",
          "condition": {
            "modules": [
              "fistful"
            ]
          },
          "ref": "A Fistful of Cards rules"
        }
      ]
    },
    {
      "id": "reminders",
      "title": "Easy to forget",
      "kind": "REMINDERS",
      "steps": [
        {
          "id": "colt",
          "text": "Everyone starts with a Colt .45 (range 1) printed on their board",
          "ref": "Weapons"
        },
        {
          "id": "hand-limit",
          "text": "Hand limit at end of turn = your current life points",
          "ref": "Characters"
        },
        {
          "id": "event-cards",
          "text": "From the Sheriff's 2nd turn: before each Sheriff turn reveal the next event card into the center; the top one is in effect",
          "condition": {
            "modules": [
              "high-noon"
            ]
          },
          "ref": "High Noon rules"
        },
        {
          "id": "event-cards-f",
          "text": "From the Sheriff's 2nd turn: before each Sheriff turn reveal the next Fistful card into the center; the top one is in effect",
          "condition": {
            "modules": [
              "fistful"
            ],
            "notModules": [
              "high-noon"
            ]
          },
          "ref": "A Fistful of Cards rules"
        }
      ]
    },
    {
      "id": "start",
      "title": "Start playing",
      "kind": "START",
      "steps": [
        {
          "id": "first",
          "text": "The Sheriff begins; play is clockwise",
          "ref": "The Game"
        }
      ]
    }
  ]
}
