        },
        {
          "id": "deputy",
          "text": "Deputy",
          "ref": "Object of the Game",
          "details": [
            "Protect the Sheriff; win with him"
          ]
        },
        {
          "id": "outlaw",
          "text": "Outlaw",
          "ref": "Object of the Game",
          "details": [
            "Kill the Sheriff",
            "Anyone who eliminates an Outlaw draws 3 cards"
          ]
        },
        {
          "id": "renegade",
          "text": "Renegade",
          "ref": "Object of the Game",
          "details": [
            "Be the last one alive; if the Sheriff dies while others live, the Outlaws win"
          ]
        }
      ]
    },
