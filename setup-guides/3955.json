{
  "schemaVersion": 1,
  "gameId": 3955,
  "gameName": "BANG!",
  "version": 4,
  "provenance": {
    "origin": "BOARDFLOW",
    "author": "BoardFlow",
    "sources": [
      "BANG! rulebook (dV Giochi, via RulesPal)",
      "High Noon rules",
      "A Fistful of Cards rules",
      "BANG! Legends rules",
      "Dodge City rules",
      "Gold Rush rules",
      "The Valley of Shadows rules",
      "Wild West Show rules",
      "The Great Train Robbery rules"
    ]
  },
  "players": {
    "min": 4,
    "max": 7
  },
  "modules": [
    {
      "id": "simple",
      "name": "Simplified (no book cards)",
      "note": "For your first few games."
    },
    {
      "id": "high-noon",
      "name": "High Noon",
      "bggId": 8269
    },
    {
      "id": "fistful",
      "name": "A Fistful of Cards",
      "bggId": 20237
    },
    {
      "id": "legends",
      "name": "BANG! Legends",
      "bggId": 401241,
      "note": "Legendary characters replace the base characters."
    },
    {
      "id": "dodge",
      "name": "Dodge City",
      "bggId": 9653,
      "extendsMaxPlayers": 8,
      "note": "Enables 8 players; also has a 3-player variant."
    },
    {
      "id": "gold-rush",
      "name": "Gold Rush",
      "bggId": 107794
    },
    {
      "id": "valley",
      "name": "The Valley of Shadows",
      "bggId": 130046
    },
    {
      "id": "wws",
      "name": "Wild West Show",
      "bggId": 66508
    },
    {
      "id": "train",
      "name": "The Great Train Robbery",
      "bggId": 349886
    }
  ],
  "sections": [
    {
      "id": "roles",
      "title": "Roles & characters",
      "steps": [
        {
          "id": "x-characters",
          "text": "Dodge City: shuffle its 15 characters in with the originals",
          "condition": {
            "modules": [
              "dodge"
            ]
          },
          "ref": "Dodge City rules"
        },
        {
          "id": "valley-characters",
          "text": "Valley of Shadows: shuffle its 8 characters in with the originals",
          "condition": {
            "modules": [
              "valley"
            ]
          },
          "ref": "Valley of Shadows rules"
        },
        {
          "id": "wws-characters",
          "text": "Wild West Show: add its 8 characters to the others",
          "condition": {
            "modules": [
              "wws"
            ]
          },
          "ref": "Wild West Show rules"
        },
        {
          "id": "train-characters",
          "text": "Great Train Robbery: shuffle its 8 characters in with the originals",
          "condition": {
            "modules": [
              "train"
            ]
          },
          "ref": "Great Train Robbery rules"
        },
        {
          "id": "boards",
          "text": "Each player takes a playing board",
          "ref": "Preparation (p.2)"
        },
        {
          "id": "roles",
          "text": "Role cards: {r}",
          "amounts": {
            "r": {
              "byPlayers": {
                "4": "1 Sheriff, 1 Renegade, 2 Outlaws",
                "5": "1 Sheriff, 1 Renegade, 2 Outlaws, 1 Deputy",
                "6": "1 Sheriff, 1 Renegade, 3 Outlaws, 1 Deputy",
                "7": "1 Sheriff, 1 Renegade, 3 Outlaws, 2 Deputies",
                "8": "all 8 Dodge City roles (each of the 2 Renegades plays alone)"
              }
            }
          },
          "ref": "Preparation, Dodge City rules"
        },
        {
          "id": "deal-roles",
          "text": "Shuffle and deal 1 role facedown each; the Sheriff reveals, everyone else keeps theirs secret",
          "ref": "Preparation (p.2)"
        },
        {
          "id": "characters",
          "text": "Deal 1 character faceup each; announce names and abilities",
          "ref": "Preparation (p.2)",
          "condition": {
            "notModules": [
              "legends"
            ]
          }
        },
        {
          "id": "bullets",
          "text": "Take as many bullets as your character shows; the Sheriff takes one extra",
          "ref": "Preparation (p.2)"
        },
        {
          "id": "box",
          "text": "Box the remaining roles, boards and characters",
          "ref": "Preparation (p.2)"
        },
        {
          "id": "legend-chars",
          "text": "Shuffle the legendary characters; deal each player one from the bottom, normal side up",
          "condition": {
            "modules": [
              "legends"
            ]
          },
          "ref": "Legends: Setup"
        },
        {
          "id": "fame",
          "text": "Each player takes a set of 5 Fame tokens of one color",
          "condition": {
            "modules": [
              "legends"
            ]
          },
          "ref": "Legends: Setup"
        }
      ]
    },
    {
      "id": "cards",
      "title": "Cards",
      "steps": [
        {
          "id": "dodge-cards",
          "text": "Shuffle the 40 Dodge City cards into the playing cards",
          "condition": {
            "modules": [
              "dodge"
            ]
          },
          "ref": "Dodge City rules"
        },
        {
          "id": "valley-cards",
          "text": "Shuffle the 16 Valley of Shadows cards into the playing cards",
          "condition": {
            "modules": [
              "valley"
            ]
          },
          "ref": "Valley of Shadows rules"
        },
        {
          "id": "train-cards",
          "text": "Shuffle the 16 Great Train Robbery cards into the playing cards",
          "condition": {
            "modules": [
              "train"
            ]
          },
          "ref": "Great Train Robbery rules"
        },
        {
          "id": "simple",
          "text": "Remove all cards with the book symbol",
          "condition": {
            "modules": [
              "simple"
            ]
          },
          "ref": "Preparation (p.2)"
        },
        {
          "id": "deal",
          "text": "Shuffle the playing cards; deal each player as many cards as their bullets",
          "ref": "Preparation (p.2)",
          "condition": {
            "notModules": [
              "legends"
            ]
          }
        },
        {
          "id": "draw",
          "text": "Draw pile facedown in the middle, room for a discard pile",
          "ref": "Preparation (p.2)"
        },
        {
          "id": "legend-hands",
          "text": "Deal {n} cards each, whatever the bullets (Sheriff too); 6th and 7th players get 5",
          "amounts": {
            "n": 4
          },
          "condition": {
            "modules": [
              "legends"
            ]
          },
          "ref": "Legends: Setup"
        },
        {
          "id": "feats",
          "text": "Shuffle the Feat deck facedown by the draw pile; reveal 1 Feat beside it",
          "condition": {
            "modules": [
              "legends"
            ]
          },
          "ref": "Legends: Setup"
        },
        {
          "id": "high-noon",
          "text": "Sheriff shuffles the High Noon cards facedown, puts the High Noon card on top, then turns the stack faceup by them",
          "condition": {
            "modules": [
              "high-noon"
            ]
          },
          "ref": "High Noon rules"
        },
        {
          "id": "fistful",
          "text": "Sheriff shuffles the Fistful of Cards facedown, puts the A Fistful of Cards card on top, then turns the stack faceup by them",
          "condition": {
            "modules": [
              "fistful"
            ]
          },
          "ref": "A Fistful of Cards rules"
        },
        {
          "id": "nuggets",
          "text": "Gold Rush: gold nuggets in a heap in the middle; equipment deck with its first 3 cards faceup in a row; nobody starts with equipment or nuggets",
          "condition": {
            "modules": [
              "gold-rush"
            ]
          },
          "ref": "Gold Rush rules"
        },
        {
          "id": "wws-pile",
          "text": "Wild West Show: set aside the Wild West Show card, shuffle the other 9 facedown, put it at the bottom; pile in the middle of the table",
          "condition": {
            "modules": [
              "wws"
            ]
          },
          "ref": "Wild West Show rules"
        },
        {
          "id": "train-setup",
          "text": "Great Train Robbery: shuffle the Railcar deck facedown; shuffle the 13 Station tiles facedown beside it",
          "condition": {
            "modules": [
              "train"
            ]
          },
          "ref": "Great Train Robbery p.1"
        },
        {
          "id": "train-line",
          "text": "Turn over {n} Station tiles in a line, left to right; Locomotive (random side) below the leftmost Station, then 3 random Railcars to its left",
          "amounts": {
            "n": {
              "default": "one Station tile per player",
              "byPlayers": {
                "4": 4,
                "5": 5,
                "6": 6,
                "7": 7,
                "8": 8
              }
            }
          },
          "condition": {
            "modules": [
              "train"
            ]
          },
          "ref": "Great Train Robbery p.1"
        }
      ]
    },
    {
      "id": "reminders",
      "title": "Easy to forget",
      "kind": "REMINDERS",
      "steps": [
        {
          "id": "colt",
          "text": "Everyone starts with a Colt .45 (range 1) printed on their board",
          "ref": "Weapons (p.5)"
        },
        {
          "id": "hand-limit",
          "text": "Hand limit at end of turn = your current life points",
          "ref": "Characters (p.2)"
        },
        {
          "id": "event-cards",
          "text": "From the Sheriff's 2nd turn: before each Sheriff turn reveal the next event card into the center; the top one is in effect",
          "condition": {
            "modules": [
              "high-noon"
            ]
          },
          "ref": "High Noon rules"
        },
        {
          "id": "event-cards-f",
          "text": "From the Sheriff's 2nd turn: before each Sheriff turn reveal the next Fistful card into the center; the top one is in effect",
          "condition": {
            "modules": [
              "fistful"
            ],
            "notModules": [
              "high-noon"
            ]
          },
          "ref": "A Fistful of Cards rules"
        },
        {
          "id": "green",
          "text": "Dodge City: green-bordered cards are played in front of you and can't be used the turn they're played",
          "condition": {
            "modules": [
              "dodge"
            ]
          },
          "ref": "Dodge City rules"
        },
        {
          "id": "wws-reveal",
          "text": "Wild West Show: whoever plays Stagecoach or Wells Fargo takes the pile and reveals its top card, replacing the previous one",
          "condition": {
            "modules": [
              "wws"
            ]
          },
          "ref": "Wild West Show rules"
        },
        {
          "id": "three-players",
          "text": "Dodge City 3-player variant: Deputy, Outlaw and Renegade dealt faceup - Deputy kills Renegade, Renegade kills Outlaw, Outlaw kills Deputy",
          "condition": {
            "modules": [
              "dodge"
            ]
          },
          "ref": "Dodge City rules"
        }
      ]
    },
    {
      "id": "start",
      "title": "Start playing",
      "kind": "START",
      "steps": [
        {
          "id": "first",
          "text": "The Sheriff begins; play is clockwise",
          "ref": "The Game (p.3)"
        }
      ]
    }
  ]
}
