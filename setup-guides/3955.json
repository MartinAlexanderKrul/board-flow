          "condition": {
            "notModules": [
              "legends"
            ]
          }
        },
        {
          "id": "draw",
          "text": "Draw pile facedown in the middle, room for a discard pile",
          "ref": "Preparation (p.2)"
        },
        {
          "id": "legend-hands",
          "text": "Deal {n} cards each, whatever the bullets (Sheriff too); 6th and 7th players get 5",
          "amounts": {
            "n": 4
          },
          "condition": {
            "modules": [
              "legends"
            ]
          },
          "ref": "Legends: Setup"
        },
        {
          "id": "feats",
          "text": "Shuffle the Feat deck facedown by the draw pile; reveal 1 Feat beside it",
          "condition": {
            "modules": [
              "legends"
            ]
          },
          "ref": "Legends: Setup"
        },
        {
          "id": "high-noon",
          "text": "Sheriff shuffles the High Noon cards facedown, puts the High Noon card on top, then turns the stack faceup by them",
          "condition": {
            "modules": [
              "high-noon"
            ]
          },
          "ref": "High Noon rules"
        },
        {
          "id": "fistful",
          "text": "Sheriff shuffles the Fistful of Cards facedown, puts the A Fistful of Cards card on top, then turns the stack faceup by them",
          "condition": {
            "modules": [
              "fistful"
            ]
          },
          "ref": "A Fistful of Cards rules"
        },
        {
          "id": "nuggets",
          "text": "Gold Rush: gold nuggets in a heap in the middle; equipment deck with its first 3 cards faceup in a row; nobody starts with equipment or nuggets",
          "condition": {
            "modules": [
              "gold-rush"
            ]
          },
          "ref": "Gold Rush rules"
        },
        {
          "id": "wws-pile",
          "text": "Wild West Show: set aside the Wild West Show card, shuffle the other 9 facedown, put it at the bottom; pile in the middle of the table",
          "condition": {
            "modules": [
              "wws"
            ]
          },
          "ref": "Wild West Show rules"
        },
        {
          "id": "train-setup",
          "text": "Great Train Robbery: shuffle the Railcar deck facedown; shuffle the 13 Station tiles facedown beside it",
          "condition": {
            "modules": [
              "train"
            ]
          },
          "ref": "Great Train Robbery p.1"
        },
        {
          "id": "train-line",
          "text": "Turn over {n} Station tiles in a line, left to right; Locomotive (random side) below the leftmost Station, then 3 random Railcars to its left",
          "amounts": {
            "n": {
              "default": "one Station tile per player",
              "byPlayers": {
                "4": 4,
                "5": 5,
                "6": 6,
                "7": 7,
                "8": 8
              }
            }
          },
          "condition": {
            "modules": [
              "train"
            ]
          },
          "ref": "Great Train Robbery p.1"
        }
      ]
    },
    {
      "id": "roles-goals",
