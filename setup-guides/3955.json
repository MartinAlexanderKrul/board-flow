  "sections": [
    {
      "id": "roles",
      "title": "Roles & characters",
      "steps": [
        {
          "id": "x-characters",
          "text": "Dodge City: shuffle its 15 characters in with the originals",
          "condition": {
            "modules": [
              "dodge"
            ]
          },
          "ref": "Dodge City rules"
        },
        {
          "id": "valley-characters",
          "text": "Valley of Shadows: shuffle its 8 characters in with the originals",
          "condition": {
            "modules": [
              "valley"
            ]
          },
          "ref": "Valley of Shadows rules"
        },
        {
          "id": "wws-characters",
          "text": "Wild West Show: add its 8 characters to the others",
          "condition": {
            "modules": [
              "wws"
            ]
          },
          "ref": "Wild West Show rules"
        },
        {
          "id": "train-characters",
          "text": "Great Train Robbery: shuffle its 8 characters in with the originals",
          "condition": {
            "modules": [
              "train"
            ]
          },
          "ref": "Great Train Robbery rules"
        },
        {
          "id": "boards",
          "text": "Each player takes a playing board",
          "ref": "Preparation (p.2)"
        },
        {
          "id": "roles",
          "text": "Role cards: {r}",
          "amounts": {
            "r": {
              "byPlayers": {
                "4": "1 Sheriff, 1 Renegade, 2 Outlaws",
                "5": "1 Sheriff, 1 Renegade, 2 Outlaws, 1 Deputy",
                "6": "1 Sheriff, 1 Renegade, 3 Outlaws, 1 Deputy",
                "7": "1 Sheriff, 1 Renegade, 3 Outlaws, 2 Deputies",
                "8": "all 8 Dodge City roles (each of the 2 Renegades plays alone)"
              }
            }
          },
          "ref": "Preparation, Dodge City rules"
        },
        {
          "id": "deal-roles",
          "text": "Shuffle and deal 1 role facedown each; the Sheriff reveals, everyone else keeps theirs secret",
          "ref": "Preparation (p.2)"
        },
        {
          "id": "characters",
          "text": "Deal 1 character faceup each; announce names and abilities",
          "ref": "Preparation (p.2)",
          "condition": {
            "notModules": [
              "legends"
            ]
          }
        },
        {
          "id": "bullets",
          "text": "Take as many bullets as your character shows; the Sheriff takes one extra",
          "ref": "Preparation (p.2)"
        },
        {
          "id": "box",
          "text": "Box the remaining roles, boards and characters",
          "ref": "Preparation (p.2)"
        },
        {
          "id": "legend-chars",
          "text": "Shuffle the legendary characters; deal each player one from the bottom, normal side up",
          "condition": {
            "modules": [
              "legends"
            ]
          },
          "ref": "Legends: Setup"
        },
        {
          "id": "fame",
          "text": "Each player takes a set of 5 Fame tokens of one color",
          "condition": {
            "modules": [
              "legends"
            ]
          },
          "ref": "Legends: Setup"
        }
      ]
    },
    {
      "id": "cards",
      "title": "Cards",
      "steps": [
        {
          "id": "dodge-cards",
          "text": "Shuffle the 40 Dodge City cards into the playing cards",
