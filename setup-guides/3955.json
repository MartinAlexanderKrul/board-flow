            "modules": [
              "dodge"
            ]
          },
          "ref": "Dodge City rules"
        },
        {
          "id": "valley-cards",
          "text": "Shuffle the 16 Valley of Shadows cards into the playing cards",
          "condition": {
            "modules": [
              "valley"
            ]
          },
          "ref": "Valley of Shadows rules"
        },
        {
          "id": "train-cards",
          "text": "Shuffle the 16 Great Train Robbery cards into the playing cards",
          "condition": {
            "modules": [
              "train"
            ]
          },
          "ref": "Great Train Robbery rules"
        },
        {
          "id": "simple",
          "text": "Remove all cards with the book symbol",
