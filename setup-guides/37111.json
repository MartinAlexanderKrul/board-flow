    "sources": [
      "BSG rulebook (FFG)",
      "BSG: Pegasus rulebook (FFG)",
      "BSG: Exodus rulebook (FFG)",
      "BSG: Daybreak rulebook (FFG)",
      "Esoteric Order of Gamers BSG summary v4.4"
