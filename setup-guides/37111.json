      "name": "Pegasus",
      "bggId": 43539
    },
    {
      "id": "exodus",
      "name": "Exodus",
      "bggId": 85905
    },
    {
      "id": "daybreak",
      "name": "Daybreak",
      "bggId": 141648
    },
    {
      "id": "new-caprica",
      "name": "Pegasus: New Caprica ending",
      "requires": [
        "pegasus"
      ],
      "excludes": [
        "nebula",
        "search-home"
      ]
    },
    {
      "id": "cylon-fleet",
      "name": "Exodus: Cylon Fleet option",
      "requires": [
        "exodus"
      ]
    },
    {
      "id": "nebula",
      "name": "Exodus: Ionian Nebula option",
      "requires": [
        "exodus"
      ],
      "excludes": [
        "search-home"
      ]
    },
    {
      "id": "search-home",
      "name": "Daybreak: Search for Home option",
      "requires": [
        "daybreak"
      ]
    },
    {
      "id": "conflicted",
      "name": "Exodus: Conflicted Loyalties option",
      "requires": [
        "exodus"
      ]
    },
    {
      "id": "leaders",
      "name": "A Cylon Leader (needs Pegasus or Daybreak)",
      "players": {
        "min": 4,
        "max": 7
      },
      "extendsMaxPlayers": 7,
      "forcedAtPlayers": [
        7
      ],
      "note": "Only one Cylon Leader per game; with Daybreak use its Cylon Leader rules. 7 players need a Cylon Leader."
    }
  ],
  "sections": [
    {
      "id": "board",
      "title": "Board",
      "steps": [
        {
          "id": "dials",
          "text": "Board in the middle: food 8, fuel 8, morale 10, population 12",
          "ref": "BSG rulebook (FFG) p.5 step 1"
        },
        {
          "id": "pegasus-board",
          "text": "Pegasus board right of the main board (bottom edges level); Cylon overlay on the Cylon locations",
          "condition": {
            "modules": [
              "pegasus"
            ],
            "notModules": [
              "daybreak"
            ]
          },
          "ref": "BSG: Pegasus rulebook (FFG), Expansion Setup"
        },
        {
          "id": "pegasus-board-db",
          "text": "Pegasus board right of the main board (bottom edges level); use the Daybreak Cylon overlay, not the Pegasus one",
          "condition": {
            "modules": [
              "pegasus",
              "daybreak"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Combining Pegasus and Daybreak"
        },
        {
          "id": "daybreak-overlays",
          "text": "Colonial One overlay and Cylon locations overlay (destroyed sides down) on the main board",
          "condition": {
            "modules": [
              "daybreak"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Expansion Setup"
        },
        {
          "id": "reserves",
          "text": "8 vipers and 4 raptors in the Viper and Raptor Reserves; fleet token on Start of the Jump Preparation track",
          "ref": "BSG rulebook (FFG) p.5 step 2"
        },
        {
          "id": "cylon-fleet-board",
          "text": "Cylon Fleet board left of the main board, pursuit marker on Start; 2 vipers from Reserves to the box; 4 viper Mk VIIs in Damaged Vipers; add the 4 new raiders",
          "condition": {
            "modules": [
              "cylon-fleet"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG), Cylon Fleet Option Setup"
        },
        {
          "id": "assault-raptor",
          "text": "1 assault raptor in the Reserves, the others beside the board; centurion figures replace the markers",
          "condition": {
            "modules": [
              "daybreak"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Expansion Setup"
        },
        {
          "id": "tokens",
          "text": "All other tokens facedown and the plastic ships beside the board",
          "ref": "BSG rulebook (FFG) p.5 step 2"
        },
        {
          "id": "pegasus-damage",
          "text": "Scar and Pegasus damage tokens beside the board (Pegasus damage apart from Galactica's)",
          "condition": {
            "modules": [
              "pegasus"
            ]
          },
          "ref": "BSG: Pegasus rulebook (FFG), Expansion Setup"
        },
        {
          "id": "exodus-nuke",
          "text": "Extra nuke token beside the board (the humans still start with 2, max 3)",
          "condition": {
            "modules": [
              "exodus"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG), Expansion Setup"
        },
        {
          "id": "nebula-tokens",
          "text": "Exodus basestar damage tokens replace the core ones; trauma tokens facedown, 1 unseen on Sickbay and 1 on the Brig",
          "condition": {
            "modules": [
              "nebula"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG), Ionian Nebula Option Setup"
        },
        {
          "id": "demetrius",
          "text": "Demetrius board left of the main board (leave room for the Rebel Basestar board further left)",
          "condition": {
            "modules": [
              "search-home"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Search for Home Setup"
        }
      ]
    },
    {
      "id": "characters",
      "title": "Characters",
      "steps": [
        {
          "id": "first",
          "text": "A random first player takes the current player token and picks first",
          "ref": "BSG rulebook (FFG) p.5 step 3"
        },
        {
          "id": "characters-pegasus",
          "text": "Add the 7 Pegasus character sheets",
          "condition": {
            "modules": [
              "pegasus"
            ]
          },
          "ref": "BSG: Pegasus rulebook (FFG), Expansion Setup"
        },
        {
          "id": "characters-exodus",
          "text": "Add the 4 Exodus character sheets",
          "condition": {
            "modules": [
              "exodus"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG), Expansion Setup"
        },
        {
          "id": "characters-daybreak",
          "text": "Add the Daybreak sheets; only one version each of Lee Adama, Zarek, Helo and Baltar (both still count for type)",
          "condition": {
            "modules": [
              "daybreak"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Choosing Characters"
        },
        {
          "id": "choose",
          "text": "Clockwise, each player picks a character of the most plentiful type (political, military, pilot); support characters any time",
          "ref": "BSG rulebook (FFG) p.5 step 4"
        },
        {
          "id": "place",
          "text": "Take the sheet, standee and any piloting token; place the standee where the sheet says",
          "ref": "BSG rulebook (FFG) p.5 step 4"
        },
        {
          "id": "miracle",
          "text": "Each player puts 1 miracle token on their sheet; the rest in a pile",
          "condition": {
            "modules": [
              "daybreak"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Expansion Setup"
        },
        {
          "id": "titles",
          "text": "President: first of Roslin, Baltar, Zarek. Admiral: first of Adama, Tigh, Helo; the Admiral takes 2 nukes",
          "ref": "BSG rulebook (FFG) p.5 step 5"
        },
        {
          "id": "cag",
          "text": "Cylon Fleet: CAG title by its line of succession; the Alternate Admiral title replaces the Admiral card",
          "condition": {
            "modules": [
              "cylon-fleet"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG), Cylon Fleet Option Setup"
        },
        {
          "id": "nc-titles",
          "text": "New Caprica: use the Pegasus President and Admiral title cards instead",
          "condition": {
            "modules": [
              "new-caprica"
            ]
          },
          "ref": "BSG: Pegasus rulebook (FFG), Components"
        },
        {
          "id": "quorum",
          "text": "The President shuffles the Quorum deck and draws 1",
          "ref": "BSG rulebook (FFG) p.5 step 5"
        },
        {
          "id": "cylon-leader-p",
          "text": "The Cylon Leader takes the Infiltration card; split the Agenda cards into Sympathetic and Hostile decks",
          "condition": {
            "modules": [
              "leaders"
            ],
            "notModules": [
              "daybreak"
            ]
          },
          "ref": "BSG: Pegasus rulebook (FFG), Expansion Setup"
        },
        {
          "id": "cylon-leader",
          "text": "The Cylon Leader takes the Infiltration card; shuffle the Motive cards beside the board",
          "condition": {
            "modules": [
              "leaders",
              "daybreak"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Expansion Setup"
        }
      ]
    },
    {
      "id": "loyalty",
      "title": "Loyalty deck",
      "steps": [
        {
          "id": "organize",
          "text": "Box the Sympathizer card; split the Not a Cylon and Cylon cards into 2 piles and shuffle each",
          "condition": {
            "notModules": [
              "daybreak"
            ]
          },
          "ref": "BSG rulebook (FFG) p.6"
        },
        {
          "id": "organize-db",
          "text": "Box the Sympathizer card and set the Mutineer card by the board; split the Not a Cylon and Cylon cards into 2 piles and shuffle each",
          "condition": {
            "modules": [
              "daybreak"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Creating the Loyalty Deck"
        },
        {
          "id": "pegasus-loyalty",
          "text": "Include the Pegasus You Are a Cylon card (the Sympathetic Cylon card is only for its variant)",
          "condition": {
            "modules": [
              "pegasus"
            ],
            "notModules": [
              "daybreak"
            ]
          },
          "ref": "BSG: Pegasus rulebook (FFG), Components"
        },
        {
          "id": "exodus-piles",
          "text": "Include the Exodus Loyalty cards in both piles; box Personal Goal and Final Five cards",
          "condition": {
            "modules": [
              "exodus"
            ],
            "notModules": [
              "conflicted"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG), Creating the Loyalty Deck"
        },
        {
          "id": "conflicted",
          "text": "Conflicted Loyalties: include the Exodus Loyalty cards; shuffle the Personal Goal and/or Final Five cards (your choice) into the Not a Cylon pile",
          "condition": {
            "modules": [
              "conflicted"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG), Conflicted Loyalties Option Setup"
        },
        {
          "id": "build",
          "text": "Build the Loyalty deck: {n}",
          "amounts": {
            "n": {
              "byPlayers": {
                "3": "1 Cylon + 5 Not a Cylon",
                "4": "1 Cylon + 6 Not a Cylon",
                "5": "2 Cylon + 8 Not a Cylon",
                "6": "2 Cylon + 9 Not a Cylon"
              },
              "cases": [
                {
                  "when": {
                    "players": [
                      4
                    ],
                    "modules": [
                      "daybreak",
                      "leaders"
                    ]
                  },
                  "value": "1 Cylon + 5 Not a Cylon"
                },
                {
                  "when": {
                    "players": [
                      5
                    ],
                    "modules": [
                      "daybreak",
                      "leaders"
                    ]
                  },
                  "value": "1 Cylon + 7 Not a Cylon + the Mutineer"
                },
                {
                  "when": {
                    "players": [
                      6
                    ],
                    "modules": [
                      "daybreak",
                      "leaders"
                    ]
                  },
                  "value": "2 Cylon + 8 Not a Cylon"
                },
                {
                  "when": {
                    "players": [
                      7
                    ],
                    "modules": [
                      "daybreak",
                      "leaders"
                    ]
                  },
                  "value": "2 Cylon + 10 Not a Cylon + the Mutineer"
                },
                {
                  "when": {
                    "players": [
                      3
                    ],
                    "modules": [
                      "daybreak"
                    ]
                  },
                  "value": "1 Cylon + 5 Not a Cylon"
                },
                {
                  "when": {
                    "players": [
                      4
                    ],
                    "modules": [
                      "daybreak"
                    ]
                  },
                  "value": "1 Cylon + 7 Not a Cylon + the Mutineer"
                },
                {
                  "when": {
                    "players": [
                      5
                    ],
                    "modules": [
                      "daybreak"
                    ]
                  },
                  "value": "2 Cylon + 8 Not a Cylon"
                },
                {
                  "when": {
                    "players": [
                      6
                    ],
                    "modules": [
                      "daybreak"
                    ]
                  },
                  "value": "2 Cylon + 10 Not a Cylon + the Mutineer"
                },
                {
                  "when": {
                    "players": [
                      4
                    ],
                    "modules": [
                      "leaders"
                    ]
                  },
                  "value": "1 Cylon + 5 Not a Cylon"
                },
                {
                  "when": {
                    "players": [
                      5
                    ],
                    "modules": [
                      "leaders"
                    ]
                  },
                  "value": "1 Cylon + 7 Not a Cylon"
                },
                {
                  "when": {
                    "players": [
                      6
                    ],
                    "modules": [
                      "leaders"
                    ]
                  },
                  "value": "2 Cylon + 8 Not a Cylon"
                },
                {
                  "when": {
                    "players": [
                      7
                    ],
                    "modules": [
                      "leaders"
                    ]
                  },
                  "value": "2 Cylon + 10 Not a Cylon"
                }
              ]
            }
          },
          "ref": "BSG rulebook (FFG) p.6 / BSG: Pegasus rulebook (FFG), Cylon Leader / BSG: Daybreak rulebook (FFG), Loyalty Deck Chart"
        },
        {
          "id": "exodus-extra",
          "text": "Exodus: 1 more Not a Cylon card",
          "condition": {
            "modules": [
              "exodus"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG) / BSG: Daybreak rulebook (FFG), Combining"
        },
        {
          "id": "adjust",
          "text": "+1 Not a Cylon for each Sharon \"Boomer\" Valerii or Gaius Baltar in play (not the alternate Baltar)",
          "ref": "BSG rulebook (FFG) p.6 / BSG: Daybreak rulebook (FFG), Creating the Loyalty Deck"
        },
        {
          "id": "agenda",
          "text": "Deal the Cylon Leader {a} Agenda card instead of a Loyalty card",
          "amounts": {
            "a": {
              "default": "a Sympathetic",
              "cases": [
                {
                  "when": {
                    "players": [
                      5
                    ]
                  },
                  "value": "a Hostile"
                },
                {
                  "when": {
                    "players": [
                      7
                    ]
                  },
                  "value": "a Hostile"
                }
              ]
            }
          },
          "condition": {
            "modules": [
              "leaders"
            ],
            "notModules": [
              "daybreak"
            ]
          },
          "ref": "BSG: Pegasus rulebook (FFG), Cylon Leader"
        },
        {
          "id": "motives",
          "text": "Deal the Cylon Leader 2 Motive cards instead of a Loyalty card",
          "condition": {
            "modules": [
              "leaders",
              "daybreak"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Creating the Loyalty Deck"
        },
        {
          "id": "deal",
          "text": "Shuffle; deal 1 facedown to each player (original Baltar gets 2, a Cylon Leader none)",
          "ref": "BSG rulebook (FFG) p.6 / BSG: Daybreak rulebook (FFG), Creating the Loyalty Deck"
        },
        {
          "id": "sympathizer",
          "text": "Shuffle the Sympathizer card into the rest",
          "condition": {
            "players": [
              4,
              6
            ],
            "notModules": [
              "daybreak",
              "leaders"
            ]
          },
          "ref": "BSG rulebook (FFG) p.6"
        },
        {
          "id": "box-rest",
          "text": "Loyalty deck beside the board; box unused Loyalty cards unseen",
          "condition": {
            "notModules": [
              "exodus"
            ]
          },
          "ref": "BSG rulebook (FFG) p.6"
        },
        {
          "id": "box-rest-exodus",
          "text": "Loyalty deck beside the board with the rest of the Not a Cylon pile apart from it; box the unused Cylon cards unseen",
          "condition": {
            "modules": [
              "exodus"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG), Creating the Loyalty Deck"
        }
      ]
    },
    {
      "id": "cards",
      "title": "Cards",
      "steps": [
        {
          "id": "cards-pegasus",
          "text": "Shuffle the Pegasus Crisis, Quorum, Super Crisis, Skill and Destination cards into their decks; box the core Investigative Committee cards",
          "condition": {
            "modules": [
              "pegasus"
            ]
          },
          "ref": "BSG: Pegasus rulebook (FFG), Expansion Setup"
        },
        {
          "id": "cards-exodus",
          "text": "Shuffle the Exodus Crisis, Quorum, Super Crisis, Skill and Destination cards into their decks (the CAG Chooses cards only with the Cylon Fleet)",
          "condition": {
            "modules": [
              "exodus"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG), Expansion Setup"
        },
        {
          "id": "cards-daybreak",
          "text": "Shuffle the Daybreak Crisis and Skill cards into their decks",
          "condition": {
            "modules": [
              "daybreak"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Expansion Setup"
        },
        {
          "id": "cylon-fleet-cards",
          "text": "Box all Cylon attack Crisis and Super Crisis cards (Daybreak ones too)",
          "condition": {
            "modules": [
              "cylon-fleet"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG), Cylon Fleet Option Setup"
        },
        {
          "id": "decks",
          "text": "Shuffle the Quorum, Crisis, Super Crisis and Destination decks beside the board",
          "ref": "BSG rulebook (FFG) p.5 step 7"
        },
        {
          "id": "skills",
          "text": "Skill cards: 5 decks by type, shuffled, below the matching colours on the board",
          "ref": "BSG rulebook (FFG) p.5 step 7"
        },
        {
          "id": "treachery",
          "text": "Shuffle the Treachery cards below the marked area of the Pegasus board",
          "condition": {
            "modules": [
              "pegasus"
            ],
            "notModules": [
              "daybreak"
            ]
          },
          "ref": "BSG: Pegasus rulebook (FFG), Expansion Setup"
        },
        {
          "id": "treachery-daybreak",
          "text": "Shuffle the Daybreak Treachery cards right of the Engineering deck; box the Pegasus Treachery, overlay, Infiltration and Agenda cards",
          "condition": {
            "modules": [
              "daybreak"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Expansion Setup / Combining"
        },
        {
          "id": "mutiny",
          "text": "Shuffle the Mutiny deck facedown next to the Crisis deck",
          "condition": {
            "modules": [
              "daybreak"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Expansion Setup"
        },
        {
          "id": "objective",
          "text": "Kobol Objective faceup by the Destination deck",
          "condition": {
            "notModules": [
              "new-caprica",
              "nebula",
              "search-home"
            ]
          },
          "ref": "BSG rulebook (FFG) p.5 step 7"
        },
        {
          "id": "objective-nc",
          "text": "New Caprica Objective instead of Kobol; New Caprica board, its shuffled Crisis cards and occupation forces tokens set aside for later",
          "condition": {
            "modules": [
              "new-caprica"
            ]
          },
          "ref": "BSG: Pegasus rulebook (FFG), Expansion Setup"
        },
        {
          "id": "objective-nebula",
          "text": "Ionian Nebula Objective instead of Kobol; Crossroads cards shuffled and set aside",
          "condition": {
            "modules": [
              "nebula"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG), Ionian Nebula Option Setup"
        },
        {
          "id": "allies",
          "text": "Ally deck: 3 faceup (box allies who are chosen characters), each with 1 unseen trauma token, ally tokens on their locations",
          "condition": {
            "modules": [
              "nebula"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG), Ionian Nebula Option Setup"
        },
        {
          "id": "trauma-deal",
          "text": "Each player draws 3 trauma tokens secretly; redraw any disaster token",
          "condition": {
            "modules": [
              "nebula"
            ]
          },
          "ref": "BSG: Exodus rulebook (FFG), Ionian Nebula Option Setup"
        },
        {
          "id": "objective-earth",
          "text": "Earth Objective instead of Kobol; shuffle the Mission deck by the Demetrius board",
          "condition": {
            "modules": [
              "search-home"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Search for Home Setup"
        },
        {
          "id": "receive",
          "text": "Every player except the first draws 3 Skill cards from their Receive Skills types (Cylon Leader: 2)",
          "ref": "BSG rulebook (FFG) p.5 step 8"
        },
        {
          "id": "destiny",
          "text": "Destiny deck: 2 Skill cards of each type facedown on its space, shuffled",
          "condition": {
            "notModules": [
              "pegasus",
              "daybreak"
            ]
          },
          "ref": "BSG rulebook (FFG) p.5 step 9"
        },
        {
          "id": "destiny-treachery",
          "text": "Destiny deck: 2 Skill cards of each type plus 2 Treachery (12 cards), shuffled",
          "condition": {
            "modules": [
              "pegasus"
            ]
          },
          "ref": "BSG: Pegasus rulebook (FFG), Expansion Setup"
        },
        {
          "id": "destiny-treachery-db",
          "text": "Destiny deck: 2 Skill cards of each type plus 2 Treachery (12 cards), shuffled",
          "condition": {
            "modules": [
              "daybreak"
            ],
            "notModules": [
              "pegasus"
            ]
          },
          "ref": "BSG: Daybreak rulebook (FFG), Expansion Setup"
        },
        {
          "id": "ships",
          "text": "1 basestar and 3 raiders in front of Galactica; 2 vipers below it; 2 civilian ships behind it",
          "ref": "BSG rulebook (FFG) p.5 step 10"
        }
      ]
    },
    {
      "id": "reminders",
      "title": "Easy to forget",
      "kind": "REMINDERS",
      "steps": [
        {
          "id": "first-no-hand",
          "text": "The first player gets no starting Skill cards; they draw at the start of their turn",
          "ref": "BSG rulebook (FFG) p.5 step 8"
        },
        {
          "id": "resources-zero",
          "text": "Humans lose when any resource is 0 at the end of a turn",
          "ref": "BSG rulebook (FFG) p.5"
        },
        {
          "id": "human-goal",
          "text": "Humans win by travelling 8 distance and jumping once more",
          "condition": {
            "notModules": [
              "new-caprica",
              "nebula",
              "search-home"
            ]
          },
          "ref": "BSG rulebook (FFG) p.6"
        }
      ]
    },
    {
      "id": "start",
      "title": "Start playing",
      "kind": "START",
      "steps": [
        {
