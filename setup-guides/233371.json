  "sections": [
    {
      "id": "ship",
      "title": "Spaceship",
      "steps": [
        {
          "id": "board",
          "text": "Assemble the ship: Cargo Bay, Command and Corridor always; the other 3 modules in any position, either side up",
          "note": "First game: Hydroponics, Doomsday Cannon, Med Lab as shown",
          "ref": "Setup A",
          "condition": {
            "modules": [
              "flagship"
            ]
          }
        },
        {
          "id": "cyber-board",
          "text": "Assemble the 6 single-sided Cyber Station 11 pieces as shown (no Clank! In! Space! single-sided pieces) plus 3 double-sided modules",
          "condition": {
            "modules": [
              "cyber"
            ]
          },
          "ref": "Cyber Station 11 p.2"
        },
        {
          "id": "pulsar-board",
          "text": "Cargo Bay and Corridor, the Master Control - Pulsarcade instead of Command, plus 3 double-sided modules (new or old)",
          "condition": {
            "modules": [
              "pulsar"
            ]
          },
          "ref": "Pulsarcade p.1"
        },
        {
          "id": "scheme",
          "text": "Choose a Scheme (random, or Category 1 for a first game); box the others; place it beside the board",
          "condition": {
            "modules": [
              "apocalypse"
            ]
          },
          "ref": "Apocalypse! p.1"
        },
        {
          "id": "scheme-modules",
          "text": "Suggested: use at least one new Apocalypse! module, and any module the Scheme names",
          "condition": {
            "modules": [
              "apocalypse"
            ]
          },
          "ref": "Apocalypse! p.1"
        },
        {
          "id": "pulsar-artifacts",
          "text": "All 6 artifacts faceup on the Master Control spaces, whatever the player count",
          "condition": {
            "modules": [
              "pulsar"
            ]
          },
          "ref": "Pulsarcade p.1"
        },
        {
          "id": "cyber-pods",
          "text": "The four 20-point Escape Pods along the lower edge of the board",
          "condition": {
            "modules": [
              "cyber"
            ]
          },
          "ref": "Cyber Station 11 p.2"
        },
        {
          "id": "disguise",
          "text": "Disguise Kits on the Market Board ({n})",
          "amounts": {
            "n": {
              "default": "both",
              "byPlayers": {
                "2": "only 1"
              }
            }
          },
          "condition": {
            "modules": [
              "pulsar"
            ]
          },
          "ref": "Pulsarcade p.1"
        },
        {
          "id": "cabinets",
          "text": "Arcade Cabinets sorted by title in stacks near the Master Control",
          "note": "2 players: box one of each (two each of Dragon's Den and Ping remain, one of the others)",
          "condition": {
            "modules": [
              "pulsar"
            ]
          },
          "ref": "Pulsarcade p.1"
        },
        {
          "id": "artifacts",
          "text": "Artifacts faceup on the matching numbered Command spaces{x}",
          "amounts": {
            "x": {
              "default": "",
              "byPlayers": {
                "2": " - first box 2 random ones unseen",
                "3": " - first box 1 random one unseen"
              }
            }
          },
          "ref": "Setup C",
          "condition": {
            "notModules": [
              "pulsar"
            ]
          }
        },
        {
          "id": "major",
          "text": "Shuffle the Major Secrets; 1 on each Major Secret space",
          "ref": "Setup D"
        },
        {
          "id": "minor",
          "text": "Shuffle the Minor Secrets; 2 on each Minor Secret space; box extras unseen",
          "ref": "Setup E"
        },
        {
          "id": "market",
          "text": "Market Board by the ship with {n} each of Contraband, Master Key, Med Kit and TelePass",
          "amounts": {
            "n": {
              "default": 2,
              "byPlayers": {
                "2": 1
              }
            }
          },
          "ref": "Setup F"
        },
        {
          "id": "pods",
          "text": "4 Escape Pod tokens in the Cargo Bay",
          "ref": "Setup G",
          "condition": {
            "notModules": [
              "cyber"
            ]
          }
        },
        {
          "id": "bank",
          "text": "Bank: 5 Power Crystals, {n} Command Code tokens and all Credits",
          "amounts": {
            "n": {
              "default": "1 per player",
              "byPlayers": {
                "2": 2,
                "3": 3,
                "4": 4
              }
            }
          },
          "ref": "Setup H"
        }
      ]
    },
    {
      "id": "rage",
      "title": "Rage Track & boss",
      "steps": [
        {
          "id": "hunters",
          "text": "4 red Bounty Hunter cubes: one on each of the first two red-zone spaces, two on the plaid space",
          "ref": "Setup I"
        },
        {
          "id": "blockade",
          "text": "Blockade token on the last space of the red zone",
          "ref": "Setup J",
          "condition": {
            "notModules": [
              "cyber"
            ]
          }
        },
        {
          "id": "boss-marker",
          "text": "Boss Marker on the space for {n} players",
          "amounts": {
            "n": {
              "default": "your number of"
            }
          },
          "ref": "Setup K"
        },
        {
          "id": "bag",
          "text": "24 black boss cubes in the Boss Bag",
          "ref": "Setup L"
        },
        {
          "id": "exec-pods",
          "text": "Two 10-point Executive Escape Pods on the marked Rage Track space (no Blockade)",
          "condition": {
            "modules": [
              "cyber"
            ]
          },
          "ref": "Cyber Station 11 p.2"
        }
      ]
    },
    {
      "id": "cards",
      "title": "Cards",
      "steps": [
        {
          "id": "reserve",
          "text": "Reserve: G:B-L1N plus the FAZR, Boldly Go and Memory Core piles",
          "ref": "Setup M"
        },
        {
          "id": "row",
          "text": "Shuffle the Adventure Deck; deal {n} faceup as the Adventure Row, replacing any with the Boss Attack symbol (reshuffle those)",
          "amounts": {
            "n": 6
          },
          "ref": "Setup N",
          "note": "Shuffle in the 35 Apocalypse! and/or 40 Cyber Station 11 cards first if used"
        }
      ]
    },
    {
      "id": "players",
      "title": "Players",
      "steps": [
        {
          "id": "supply",
          "text": "Each player: a pawn, 30 Clank! cubes and 2 Data cubes of their color",
          "ref": "Setup B"
        },
        {
          "id": "deck",
          "text": "Starting deck: 6 Hacks, 2 Stumbles, 1 Access, 1 Scramble",
          "ref": "Setup B"
        },
        {
          "id": "start-space",
          "text": "Pawns on the starting space ({w}); shuffle and draw 5",
          "ref": "Setup O",
          "amounts": {
            "w": {
              "default": "Cargo Bay",
              "cases": [
                {
                  "when": {
                    "modules": [
                      "cyber"
                    ]
                  },
                  "value": "center of the board"
                }
              ]
            }
          }
        },
        {
          "id": "clank",
          "text": "Starting Clank! in the Clank! area: 1st player 3, 2nd 2, 3rd 1, 4th 0",
          "ref": "Setup P"
        }
      ]
    },
    {
      "id": "reminders",
      "title": "Easy to forget",
      "kind": "REMINDERS",
      "steps": [
        {
          "id": "pulsar-modules",
          "text": "Some Pulsarcade modules need extra setup - see their rules",
          "condition": {
            "modules": [
              "pulsar"
            ]
          },
          "ref": "Pulsarcade p.1"
        },
        {
          "id": "scheme-cubes",
          "text": "Drawn black cubes go on the Scheme's current Phase",
          "condition": {
            "modules": [
              "apocalypse"
            ]
          },
          "ref": "Apocalypse! p.2"
        },
        {
          "id": "cyber-safe",
          "text": "Cyber Station 11 has two safe areas; knocked out elsewhere scores 0",
          "condition": {
            "modules": [
              "cyber"
            ]
          },
          "ref": "Cyber Station 11 p.2"
        }
      ]
    },
    {
      "id": "start",
      "title": "Start playing",
      "kind": "START",
      "steps": [
        {
          "id": "first",
          "text": "The sneakiest player (or a random one) goes first; play is clockwise",
          "ref": "Setup P"
        }
      ]
