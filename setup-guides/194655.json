      "title": "Start playing",
      "kind": "START",
      "steps": [
        {
          "id": "start-1",
          "text": "The youngest player places 2 Workers on any free spaces, then the others place theirs",
          "condition": {
            "notModules": [
              "gods"
            ]
          },
          "ref": "Setup (p.1)"
        },
        {
          "id": "start-2",
          "text": "The Challenger picks a Start Player, who places 2 Workers; the others place theirs clockwise",
          "condition": {
            "modules": [
              "gods"
            ]
          },
          "ref": "God Power Setup (p.2)"
        },
        {
          "id": "start-3",
          "text": "On your turn move one Worker, then build with it",
          "ref": "How to play (p.1)"
        }
      ]
    }
  ]
}
