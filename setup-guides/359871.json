{
  "schemaVersion": 1,
  "gameId": 359871,
  "gameName": "Arcs",
  "version": 2,
  "provenance": {
    "origin": "BOARDFLOW",
    "author": "BoardFlow",
    "sources": [
      "Arcs base rulebook (Leder Games, Aug 27, 2025)",
      "Arcs: The Blighted Reach campaign rulebook (Leder Games, Dec 18, 2023)"
    ]
  },
  "players": {
    "min": 2,
    "max": 4
  },
  "modules": [
    {
      "id": "single-game",
      "name": "Single game",
      "group": "Mode",
      "defaultEnabled": true
    },
    {
      "id": "campaign-act-1",
      "name": "Campaign: Act I",
      "group": "Mode",
      "bggId": 363757,
      "note": "The Blighted Reach campaign, first game. Play at least one single game first."
    },
    {
      "id": "campaign-later-act",
      "name": "Campaign: Act II or III",
      "group": "Mode",
      "note": "Continue from the end of the previous Act, after its Intermission."
    },
    {
      "id": "leaders-and-lore",
      "name": "Leaders & Lore",
      "bggId": 419279,
      "requires": [
        "single-game"
      ],
      "note": "Not for a first game. Leader cards replace the standard starting pieces and resources. The Leaders & Lore Pack adds more leaders and lore to choose from."
    },
    {
      "id": "extra-lore",
      "name": "Two lore cards each",
      "requires": [
        "leaders-and-lore"
      ],
      "note": "More chaos: every player drafts a second lore card."
    }
  ],
  "sections": [
    {
      "id": "table",
      "title": "Table",
      "condition": {
        "notModules": [
          "campaign-later-act"
        ]
      },
      "steps": [
        {
          "id": "map",
          "text": "Place the map; set out the 18 battle dice and 25 resource tokens",
          "ref": "p.4 A",
          "condition": {
            "modules": [
              "single-game"
            ]
          }
        },
        {
          "id": "map-campaign",
          "text": "Place the map; set out the 18 battle dice, 25 resource tokens, 24 Blight tokens, 28 Free cities and 14 Free starports",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.4 A"
        },
        {
          "id": "initiative",
          "text": "Give the initiative marker to a random player",
          "ref": "p.4 B"
        },
        {
          "id": "action-deck",
          "text": "Shuffle the 20 action cards numbered 2-6 to start the action deck",
          "ref": "p.4 C"
        },
        {
          "id": "action-deck-4p",
          "text": "Shuffle the 8 action cards numbered 1 and 7 into the action deck",
          "condition": {
            "players": [
              4
            ]
          },
          "ref": "p.4 D"
        },
        {
          "id": "action-deck-box",
          "text": "Return the 8 action cards numbered 1 and 7 to the box",
          "condition": {
            "maxPlayers": 3
          },
          "ref": "p.4 D"
        },
        {
          "id": "events",
          "text": "Shuffle {n} Event action cards into the action deck",
          "amounts": {
            "n": {
              "byPlayers": {
                "2": 2,
                "3": 2,
                "4": 3
              }
            }
          },
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.4 E"
        },
        {
          "id": "ambitions",
          "text": "3 ambition markers, blue (lower-number) side up, in Available Markers on the map",
          "ref": "p.4 E"
        },
        {
          "id": "chapter",
          "text": "Chapter marker on space 1 of the Chapter track",
          "ref": "p.4 F",
          "condition": {
            "modules": [
              "single-game"
            ]
          }
        },
        {
          "id": "chapter-campaign",
          "text": "Chapter track tile over the chapter track, \"Act I & II\" side up; chapter marker on its 1 space",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.4 G"
        },
        {
          "id": "zero",
          "text": "Zero marker in the Ambition Declared slot",
          "ref": "p.4 G"
        },
        {
          "id": "court",
          "text": "Shuffle the 6 Vox and 25 Guild cards into the Court deck; deal {n} face up as the Court row",
          "amounts": {
            "n": {
              "byPlayers": {
                "2": 3,
                "3": 4,
                "4": 4
              }
            }
          },
          "ref": "p.4 H",
          "condition": {
            "modules": [
              "single-game"
            ]
          }
        },
        {
          "id": "court-campaign",
          "text": "Shuffle the 15 campaign Vox and Guild cards (marked CC) into the Court deck; deal {n} into the Court row",
          "amounts": {
            "n": {
              "byPlayers": {
                "2": 3,
                "3": 4,
                "4": 4
              }
            }
          },
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "note": "Leave out the base Court cards (marked BC)",
          "ref": "Campaign p.5 I"
        },
        {
          "id": "court-lore",
          "text": "Shuffle {n} random lore cards from the lore deck into the Court deck",
          "amounts": {
            "n": {
              "byPlayers": {
                "2": 2,
                "3": 3,
                "4": 4
              }
            }
          },
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "note": "Lore cards from expansion packs may be added too",
          "ref": "Campaign p.5 J"
        },
        {
          "id": "council",
          "text": "Imperial Council card (01) In Session side up as the leftmost Court card",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.5 K"
        },
        {
          "id": "edict-2p",
          "text": "Slide the Guild Envoys Depart edict (02) into the first slot of the rules booklet",
          "condition": {
            "modules": [
              "campaign-act-1"
            ],
            "players": [
              2
            ]
          },
          "ref": "Campaign p.5 L"
        },
        {
          "id": "edicts",
          "text": "Shuffle the 3 Govern the Imperial Reach edicts (03-05) face down, turn them all face up and slide them into the first free slot of the rules booklet",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.5 M"
        },
        {
          "id": "setup-card",
          "text": "Shuffle the {p}-player setup cards and draw 1",
          "amounts": {
            "p": {
              "byPlayers": {
                "2": 2,
                "3": 3,
                "4": 4
              }
            }
          },
          "ref": "p.4 I",
          "condition": {
            "modules": [
              "single-game"
            ]
          }
        },
        {
          "id": "out-of-play",
          "text": "In each of the {n} Out of Play clusters on the setup card: path marker over its numbered gate, 3 out-of-play markers on the planets touching that gate",
          "amounts": {
            "n": {
              "byPlayers": {
                "2": 2,
                "3": 2,
                "4": 1
              }
            }
          },
          "ref": "p.4 J",
          "condition": {
            "modules": [
              "single-game"
            ]
          }
        },
        {
          "id": "ambition-resources",
          "text": "Put the 6 resources matching the covered planets on the ambition boxes: Material and Fuel on Tycoon, Weapons on Warlord, Relics on Keeper, Psionics on Empath",
          "condition": {
            "players": [
              2
            ],
            "modules": [
              "single-game"
            ]
          },
          "ref": "p.4 K"
        },
        {
          "id": "imperial",
          "text": "Roll the number die: 1 Imperial ship in each system of the rolled cluster and of the next cluster clockwise (8 ships)",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "note": "No setup cards and no out-of-play clusters in the campaign",
          "ref": "Campaign p.5 N"
        },
        {
          "id": "free-cities",
          "text": "Roll the event die: 1 Free city on each planet with the rolled symbol outside the Imperial clusters",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.5 O"
        },
        {
          "id": "blight",
          "text": "1 damaged Blight (shaded side) in each system outside the Imperial clusters",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.5 P"
        },
        {
          "id": "ambition-resources-campaign",
          "text": "Put the 6 resources matching the planets in the Imperial clusters on the ambition boxes: Material and Fuel on Tycoon, Weapons on Warlord, Relics on Keeper, Psionics on Empath",
          "condition": {
            "modules": [
              "campaign-act-1"
            ],
            "players": [
              2
            ]
          },
          "ref": "Campaign p.5 Q"
        }
      ]
    },
    {
      "id": "players",
      "title": "Players",
      "condition": {
        "notModules": [
          "campaign-later-act"
        ]
      },
      "steps": [
        {
          "id": "pieces",
          "text": "Each player: board, 5 cities, 5 starports, 15 ships, 10 agents; cities go in the triangle slots on the board",
          "ref": "p.5 L"
        },
        {
          "id": "fates",
          "text": "Each player draws 2 \"A\" Fate cards and secretly picks 1; reveal together and take the matching Fate Sets",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.6 B"
        },
        {
          "id": "fate-setup",
          "text": "Set up from the Setup side of your objective card (the first card of your Fate Set), then flip it to its Objective side",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.6 C"
        },
        {
          "id": "objective-marker",
          "text": "Objective marker on the Power track space shown by the large clock on your objective card",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.6 D"
        },
        {
          "id": "power",
          "text": "Power markers on 0 of the Power track",
          "ref": "p.5 M"
        },
        {
          "id": "title",
          "text": "Tuck a Regent/Outlaw title card (06-09), Regent side up, under your Fate card; if nobody got the First Regent tile in setup, the initiative player takes it",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.6 F"
        },
        {
          "id": "start-a",
          "text": "Starting with the initiative player as seat 1, then clockwise: 3 ships and your leftmost city in your A system",
          "condition": {
            "notModules": [
              "leaders-and-lore"
            ],
            "modules": [
              "single-game"
            ]
          },
          "note": "Seats 1-4 match the systems 1A-4C on the setup card",
          "ref": "p.5 N"
        },
        {
          "id": "start-b",
          "text": "3 ships and 1 starport in your B system",
          "condition": {
            "notModules": [
              "leaders-and-lore"
            ],
            "modules": [
              "single-game"
            ]
          },
          "ref": "p.5 N"
        },
        {
          "id": "start-c",
          "text": "2 ships in your C system",
          "condition": {
            "minPlayers": 3,
            "notModules": [
              "leaders-and-lore"
            ],
            "modules": [
              "single-game"
            ]
          },
          "ref": "p.5 N"
        },
        {
          "id": "start-c-2p",
          "text": "2 ships in your C systems (the setup card marks 2 of them for you)",
          "condition": {
            "players": [
              2
            ],
            "notModules": [
              "leaders-and-lore"
            ],
            "modules": [
              "single-game"
            ]
          },
          "ref": "p.5 N"
        },
        {
          "id": "start-resources",
          "text": "Take the resources matching the planets of your A and B systems into your two leftmost resource slots (A first)",
          "condition": {
            "notModules": [
              "leaders-and-lore"
            ],
            "modules": [
              "single-game"
            ]
          },
          "ref": "p.5 O"
        },
        {
          "id": "campaign-place",
          "text": "In turn order: 3 ships and 1 building in an empty building slot at a planet with an Imperial ship; gain 1 resource of that planet type",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "note": "The planet may already have Rival pieces",
          "ref": "Campaign p.6 G"
        },
        {
          "id": "campaign-place-reverse",
          "text": "Then the same again in reverse turn order (last player first, counterclockwise)",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.6 H"
        },
        {
          "id": "free-fill",
          "text": "Free cities in every empty building slot on planets with Imperial ships",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.6 I"
        },
        {
          "id": "ll-leaders",
          "text": "Lay out {n} leader cards face up",
          "amounts": {
            "n": {
              "byPlayers": {
                "2": 3,
                "3": 4,
                "4": 5
              }
            }
          },
          "condition": {
            "modules": [
              "leaders-and-lore"
            ]
          },
          "ref": "p.21"
        },
        {
          "id": "ll-lore",
          "text": "Lay out {n} lore cards face up",
          "amounts": {
            "n": {
              "byPlayers": {
                "2": 3,
                "3": 4,
                "4": 5
              },
              "cases": [
                {
                  "when": {
                    "players": [
                      2
                    ],
                    "modules": [
                      "extra-lore"
                    ]
                  },
                  "value": 5
                },
                {
                  "when": {
                    "players": [
                      3
                    ],
                    "modules": [
                      "extra-lore"
                    ]
                  },
                  "value": 7
                },
                {
                  "when": {
                    "players": [
                      4
                    ],
                    "modules": [
                      "extra-lore"
                    ]
                  },
                  "value": 9
                }
              ]
            }
          },
          "condition": {
            "modules": [
              "leaders-and-lore"
            ]
          },
          "ref": "p.21"
        },
        {
          "id": "ll-draft",
          "text": "From the player right of the initiative player, counterclockwise: take 1 leader or 1 lore card; repeat until everyone has 1 leader and 1 lore",
          "condition": {
            "modules": [
              "leaders-and-lore"
            ],
            "notModules": [
              "extra-lore"
            ]
          },
          "ref": "p.21"
        },
        {
          "id": "ll-draft-extra",
          "text": "From the player right of the initiative player, counterclockwise: take 1 leader or 1 lore card; repeat until everyone has 1 leader and 2 lore",
          "condition": {
            "modules": [
              "extra-lore"
            ]
          },
          "ref": "p.21"
        },
        {
          "id": "ll-pieces",
          "text": "Place your starting pieces in your A, B and C systems as your leader card shows (pips under a ship = number of ships)",
          "condition": {
            "modules": [
              "leaders-and-lore"
            ]
          },
          "ref": "p.21"
        },
        {
          "id": "ll-resources",
          "text": "Take the 2 resources on your leader card into your 2 leftmost resource slots, in the order shown",
          "condition": {
            "modules": [
              "leaders-and-lore"
            ]
          },
          "ref": "p.21"
        },
        {
          "id": "ll-extra-steps",
          "text": "Leaders with extra setup steps do them now, in turn order",
          "condition": {
            "modules": [
              "leaders-and-lore"
            ]
          },
          "ref": "p.21"
        },
        {
          "id": "hands",
          "text": "Each player draws 6 action cards",
          "ref": "p.5 P"
        },
        {
          "id": "redraw",
          "text": "The player without initiative may discard all 6 and draw 6 new ones",
          "condition": {
            "players": [
              2
            ],
            "modules": [
              "single-game"
            ]
          },
          "ref": "p.5 P"
        },
        {
          "id": "redraw-campaign",
          "text": "The player without initiative may discard every card except Events and draw as many new ones",
          "condition": {
            "modules": [
              "campaign-act-1"
            ],
            "players": [
              2
            ]
          },
          "ref": "Campaign p.6 J"
        },
        {
          "id": "discard",
          "text": "All other action cards go face down as the action discard pile on the map; shuffle it",
          "ref": "p.5 Q",
          "condition": {
            "modules": [
              "single-game"
            ]
          }
        },
        {
          "id": "discard-campaign",
          "text": "All other action cards go to the action discard pile on the map",
          "condition": {
            "modules": [
              "campaign-act-1"
            ]
          },
          "ref": "Campaign p.6 K"
        }
      ]
    },
    {
      "id": "later-act",
      "title": "Act II or III",
      "condition": {
        "modules": [
          "campaign-later-act"
        ]
      },
      "steps": [
        {
          "id": "intermission",
          "text": "Do the Intermission at the end of the previous Act first (Rules aid)",
          "ref": "Campaign p.3 Intermission"
        },
        {
          "id": "carry-over",
          "text": "Set up the same as the end of the previous Act, Power included, with these changes",
          "ref": "Campaign p.7"
        },
        {
          "id": "ambitions-later",
          "text": "Ambition markers: Act II flips the lowest-Power one to its higher side, Act III the two lowest; the rest stay on their lower sides",
          "ref": "Campaign p.7 A"
        },
        {
          "id": "court-later",
          "text": "Shuffle the Court deck; deal {n} into the Court; flip the Imperial Council to In Session",
          "amounts": {
            "n": {
              "byPlayers": {
                "2": 3,
                "3": 4,
                "4": 4
              }
            }
          },
          "ref": "Campaign p.7 B"
        },
        {
          "id": "blight-gates",
          "text": "1 damaged Blight on each gate with no Blight and no ships",
          "ref": "Campaign p.7 C"
        },
        {
          "id": "blight-roll",
          "text": "Roll the event die: in each cluster 1 damaged Blight at the planet with that symbol; if it already has Blight, 1 at every planet of the cluster without Blight",
          "ref": "Campaign p.7 D"
        },
        {
          "id": "resources-later-2p",
          "text": "Roll the number die twice; put the 6 resources matching the planets of the 2 rolled clusters on the ambition boxes as in Act I",
          "condition": {
            "players": [
              2
            ]
          },
          "ref": "Campaign p.7 E"
        },
        {
          "id": "fate-setup-later",
          "text": "Set up from the Setup side of your objective card, then flip it to Objective; you may rearrange your resources (choices in turn order)",
          "ref": "Campaign p.7 F"
        },
        {
          "id": "objective-later",
          "text": "Objective marker on the Power track space shown at the top of your objective card (Act III: only players with a \"C\" Fate)",
          "ref": "Campaign p.7 G"
        },
        {
          "id": "chapter-later",
          "text": "Chapter track tile on the side for this Act; chapter marker on its 1 space",
          "ref": "Campaign p.7 H"
        },
        {
          "id": "hands-later",
          "text": "Each player draws 6 action cards",
          "ref": "Campaign p.7 H"
        },
        {
          "id": "redraw-later",
          "text": "The player without initiative may discard every card except Events and draw as many new ones",
          "condition": {
            "players": [
              2
            ]
          },
          "ref": "Campaign p.7 H"
        },
        {
          "id": "discard-later",
          "text": "All other action cards go to the action discard pile on the map",
          "ref": "Campaign p.7 H"
        }
      ]
    },
    {
      "id": "reminders",
      "title": "Easy to forget",
      "kind": "REMINDERS",
      "steps": [
        {
          "id": "goal",
          "text": "The game ends when someone has {n} Power; most Power wins",
          "amounts": {
            "n": {
              "byPlayers": {
                "2": 33,
                "3": 30,
                "4": 27
              }
            }
          },
          "ref": "p.2",
          "condition": {
            "modules": [
              "single-game"
            ]
          }
        },
        {
          "id": "declare",
          "text": "Only the lead card can declare an ambition: zero marker over its number, highest available ambition marker on that ambition",
          "ref": "p.3"
        },
        {
          "id": "seize",
          "text": "Seize the initiative once per round by playing an extra card face down (no actions for it)",
          "ref": "p.10"
        },
        {
          "id": "seize-7",
          "text": "Surpassing with a 7 also seizes the initiative",
          "condition": {
            "players": [
              4
            ]
          },
          "ref": "p.10"
        },
        {
          "id": "damaged",
          "text": "Anything you build in a system someone else controls is placed damaged",
          "ref": "p.12"
        },
        {
          "id": "empire-control",
          "text": "The Empire controls a system with any fresh Imperial ship; the First Regent counts as controlling it for ambitions and objectives",
          "condition": {
            "notModules": [
              "single-game"
            ]
          },
          "ref": "Campaign p.3 Empire Rules"
        },
        {
          "id": "events-cards",
          "text": "Event cards cannot be led, copied with, or discarded to seize the initiative",
          "condition": {
            "notModules": [
              "single-game"
            ]
          },
          "ref": "Campaign p.3 Event"
        }
      ]
    },
    {
      "id": "start",
      "title": "Start playing",
      "kind": "START",
      "steps": [
        {
          "id": "lead",
          "text": "The initiative player plays a lead card: one action per pip on it",
          "ref": "p.3"
        },
        {
          "id": "follow",
          "text": "Clockwise, the others Surpass (same suit, higher number: all its pips), Copy (face down: 1 lead-card action) or Pivot (other suit: 1 action)",
          "ref": "p.3"
        }
      ]
    }
  ]
}
