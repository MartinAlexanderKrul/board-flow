      "id": "mission-preparation",
      "title": "Mission preparation",
      "steps": [
        {
          "id": "mission-preparation-1",
          "text": "Shuffle the 40 large cards and deal them all out facedown, evenly",
          "note": "3 players: one gets an extra card, which stays unplayed after the last trick",
          "ref": "Mission Preparation"
        },
        {
          "id": "mission-preparation-2",
          "text": "Each player: a sonar token green side up and a reminder card",
          "ref": "Mission Preparation"
        },
        {
          "id": "mission-preparation-3",
          "text": "Distress signal token facedown",
          "ref": "Mission Preparation"
        },
        {
          "id": "mission-preparation-4",
          "text": "Shuffle the 96 small task cards facedown",
          "ref": "Mission Preparation"
        },
        {
          "id": "mission-preparation-5",
          "text": "Reveal the tasks the mission calls for in the middle",
          "ref": "Mission Preparation"
        },
        {
          "id": "mission-preparation-6",
          "text": "Whoever holds the submarine 4 announces it and is the captain",
          "ref": "Mission Preparation"
        },
        {
          "id": "mission-preparation-7",
          "text": "From the captain clockwise, pick task cards until all are taken",
          "ref": "Mission Preparation"
        }
      ]
    },
