{
  "schemaVersion": 2,
  "gameId": 478,
  "gameName": "Citadels",
  "version": 4,
  "provenance": {
    "origin": "BOARDFLOW",
    "author": "BoardFlow",
    "sources": [
      "Citadels rulebook (Fantasy Flight Games, classic edition)",
      "Citadels rules, 2016 edition (Z-Man Games, via RulesPal)"
    ]
  },
  "players": {
    "min": 2,
    "max": 8
  },
  "modules": [
    {
      "id": "classic",
      "name": "Classic edition",
      "group": "Edition",
      "defaultEnabled": true,
      "note": "8 characters; plays 2-7."
    },
    {
      "id": "new",
      "name": "2016 edition",
      "group": "Edition",
      "note": "Character tokens and unique districts; plays up to 8."
    }
  ],
  "sections": [
    {
      "id": "setup",
      "title": "Setup",
      "steps": [
        {
          "id": "setup-1",
          "text": "Remove the bonus character and district cards (marked with a white star)",
          "condition": {
            "modules": [
              "classic"
            ]
          },
          "ref": "p.3 step 1"
        },
        {
          "id": "setup-2",
          "text": "Shuffle the 8 character cards into the Character Deck",
          "condition": {
            "modules": [
              "classic"
            ]
          },
          "ref": "p.3 step 2"
        },
        {
          "id": "setup-3",
          "text": "Shuffle the remaining district cards into the District Deck",
          "condition": {
            "modules": [
              "classic"
            ]
          },
          "ref": "p.3 step 3"
        },
        {
          "id": "setup-4",
          "text": "Choose the cast of characters and put their tokens in the center in rank order",
          "condition": {
            "modules": [
              "new"
            ]
          },
          "note": "First game: the eight characters and 14 unique districts listed in the rulebook",
          "ref": "Complete Setup"
        },
        {
          "id": "setup-5",
          "text": "Shuffle 14 unique districts with the 54 basic districts",
          "condition": {
            "modules": [
              "new"
            ]
          },
          "ref": "Complete Setup"
        },
        {
          "id": "setup-6",
          "text": "Deal {n} district cards to each player",
          "amounts": {
            "n": 4
          },
          "ref": "p.3 step 4"
        },
        {
          "id": "setup-7",
          "text": "Each player takes {n} gold from the bank",
          "amounts": {
            "n": 2
          },
          "ref": "p.3 step 5"
        },
        {
          "id": "setup-8",
          "text": "The oldest player takes the Crown",
          "ref": "p.3 step 6"
        }
      ]
    },
    {
      "id": "characters",
      "title": "Characters",
      "kind": "CHARACTERS",
      "steps": [
        {
          "id": "assassin",
          "text": "1 Assassin",
          "condition": {
            "modules": [
              "classic"
            ]
          },
          "ref": "Rules p.7",
          "details": [
            "Name a character to murder: that character skips the whole turn"
          ]
        },
        {
          "id": "thief",
          "text": "2 Thief",
          "condition": {
            "modules": [
              "classic"
            ]
          },
          "ref": "Rules p.7",
          "details": [
            "Name a character: when it is called, take all of its gold",
            "Cannot rob the Assassin or the murdered character"
          ]
        },
        {
          "id": "magician",
          "text": "3 Magician",
          "condition": {
            "modules": [
              "classic"
            ]
          },
          "ref": "Rules p.7",
          "details": [
            "Once in your turn: swap your whole hand with another player's, or put any cards on the bottom of the District Deck and draw as many"
          ]
        },
        {
          "id": "king",
          "text": "4 King",
          "condition": {
            "modules": [
              "classic"
            ]
          },
          "ref": "Rules p.8",
          "details": [
            "1 gold per noble (yellow) district",
            "Takes the Crown and chooses first next round (a murdered King still takes it at the end of the round)"
          ]
        },
        {
          "id": "bishop",
          "text": "5 Bishop",
          "condition": {
            "modules": [
              "classic"
            ]
          },
          "ref": "Rules p.8",
          "details": [
            "1 gold per religious (blue) district",
            "His districts cannot be destroyed by the Warlord"
          ]
        },
        {
          "id": "merchant",
          "text": "6 Merchant",
          "condition": {
            "modules": [
              "classic"
            ]
          },
          "ref": "Rules p.8",
          "details": [
            "1 gold per trade (green) district",
            "1 extra gold after taking an action"
          ]
        },
        {
          "id": "architect",
          "text": "7 Architect",
          "condition": {
            "modules": [
              "classic"
            ]
          },
          "ref": "Rules p.8",
          "details": [
            "Draws 2 extra district cards after taking an action",
            "May build up to 3 districts"
          ]
        },
        {
          "id": "warlord",
          "text": "8 Warlord",
          "condition": {
            "modules": [
              "classic"
            ]
          },
          "ref": "Rules p.8",
          "details": [
            "1 gold per military (red) district",
            "End of turn: destroy a district by paying its cost minus 1 (not in a completed city)"
          ]
        }
      ]
    },
    {
      "id": "reminders",
      "title": "Easy to forget",
      "kind": "REMINDERS",
      "steps": [
        {
          "id": "reminders-1",
          "text": "Each round: 1 character facedown out of the round, then faceup characters: 4 players 2, 5 players 1, 6-7 players 0",
          "condition": {
            "minPlayers": 4,
            "maxPlayers": 7
          },
          "ref": "p.4-5"
        },
        {
          "id": "reminders-2",
          "text": "If the King would be set aside faceup, replace it and shuffle it back in",
          "condition": {
            "modules": [
              "classic"
            ]
          },
          "ref": "p.5"
        },
        {
          "id": "reminders-3",
          "text": "2, 3 or 7 players use the special rules",
          "condition": {
            "modules": [
              "classic"
            ]
          },
          "ref": "p.8-9"
        }
      ]
    },
    {
      "id": "start",
      "title": "Start playing",
      "kind": "START",
      "steps": [
        {
          "id": "start-1",
          "text": "The player with the Crown takes the Character Deck and chooses first",
          "ref": "p.5"
        }
      ]
    }
  ]
}
