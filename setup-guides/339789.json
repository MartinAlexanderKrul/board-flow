{
  "schemaVersion": 1,
  "gameId": 339789,
  "gameName": "Welcome to the Moon",
  "version": 1,
  "provenance": {
    "origin": "BOARDFLOW",
    "author": "BoardFlow",
    "sources": [
      "Welcome to the Moon rules (Blue Cocker, via RulesPal)"
    ]
  },
  "players": {
    "min": 1,
    "max": 6
  },
  "modules": [
    {
      "id": "adv1",
      "name": "Adventure #1: The Launch",
      "group": "Adventure",
      "defaultEnabled": true
    },
    {
      "id": "adv2",
      "name": "Adventure #2: The Journey",
      "group": "Adventure"
    },
    {
      "id": "adv3",
      "name": "Adventure #3: The Colony",
      "group": "Adventure"
    },
    {
      "id": "adv4",
      "name": "Adventure #4: The Mine",
      "group": "Adventure"
    },
    {
      "id": "adv5",
      "name": "Adventure #5: The Dome",
      "group": "Adventure"
    },
    {
      "id": "adv6",
      "name": "Adventure #6: The Virus",
      "group": "Adventure"
    },
    {
      "id": "adv7",
      "name": "Adventure #7: The Escape",
      "group": "Adventure"
    },
    {
      "id": "adv8",
      "name": "Adventure #8: The Battle",
      "group": "Adventure"
    },
    {
      "id": "campaign",
      "name": "Campaign mode",
      "note": "Play the 8 Adventures in order with the Campaign Book and its sealed cards; most stars after #8 wins."
    }
  ],
  "sections": [
    {
      "id": "table",
      "title": "Table",
      "steps": [
        {
          "id": "campaign-book",
          "text": "Open the Campaign Book at the next Adventure and follow its instructions; keep campaign cards unseen until told",
          "condition": {
            "modules": [
              "campaign"
            ]
          },
          "ref": "Evolving Campaign Mode"
        },
        {
          "id": "sheet",
          "text": "Each player: 1 marker and the Adventure sheet, on the side for this Adventure (number top left)",
          "condition": {
            "minPlayers": 2,
            "notModules": [
              "adv8"
            ]
          },
          "ref": "Standard Rules, Set Up"
        },
        {
          "id": "solo-sheet",
          "text": "Take 1 marker and the Adventure sheet for this Adventure",
          "condition": {
            "players": [
              1
            ],
            "notModules": [
              "adv8"
            ]
          },
          "ref": "Standard Rules, Set Up"
        },
        {
          "id": "missions",
          "text": "From this Adventure's Mission cards pick 1 A, 1 B and 1 C; lay them mission-initiated side up",
          "ref": "Standard Rules, Set Up"
        },
        {
          "id": "piles",
          "text": "Shuffle the Starship cards into 3 equal piles, number side up",
          "condition": {
            "minPlayers": 2
          },
          "ref": "Standard Rules, Set Up"
        }
      ]
    },
    {
      "id": "virus",
      "title": "Adventure #6: The Virus",
      "condition": {
        "modules": [
          "adv6"
        ]
      },
      "steps": [
        {
          "id": "grey-virus",
          "text": "Each player picks a quarter with an empty virus target, draws the grey virus there and circles it",
          "ref": "Adventure #6, Set Up"
        },
        {
          "id": "grey-spread",
          "text": "Then cross off 1 housing space of your choice in that quarter",
          "ref": "Adventure #6, Set Up"
        }
      ]
    },
    {
      "id": "battle",
      "title": "Adventure #8: The Battle",
      "condition": {
        "modules": [
          "adv8"
        ]
      },
      "steps": [
        {
          "id": "shared-sheets",
          "text": "One sheet between each pair of neighbours, asteroids toward the middle, A/B/C scoring boxes on your left",
          "condition": {
            "minPlayers": 2
          },
          "ref": "Adventure #8, Set Up"
        },
        {
          "id": "insignia",
          "text": "Pick an insignia different from both neighbours; draw it on the starship by your scoring area on both your sheets",
          "condition": {
            "minPlayers": 2
          },
          "ref": "Adventure #8, Set Up"
        },
        {
          "id": "captain",
          "text": "Appoint a Captain: Captain card in front of their left sheet; it moves to the other sheet each turn",
          "condition": {
            "minPlayers": 2
          },
          "ref": "Adventure #8, Set Up"
        },
        {
          "id": "solo-battle",
          "text": "Solo: 2 Adventure #8 sheets side by side; draw ASTRA's insignia (the triangle) on the far starships; Captain card in front of the left sheet",
          "condition": {
            "players": [
              1
            ]
          },
          "ref": "ASTRA Solo Mode (Adventure #8)"
        }
      ]
    },
    {
      "id": "astra",
      "title": "ASTRA solo",
      "condition": {
        "players": [
          1
        ]
      },
      "steps": [
        {
          "id": "opponent",
          "text": "Pick an ASTRA Opponent card (the number is its difficulty, 1 = easy)",
          "ref": "ASTRA Solo Mode, Set Up"
        },
        {
          "id": "adventure-card",
          "text": "Take the ASTRA Adventure card for this Adventure; line it up with the Opponent card as ASTRA's scoring area",
          "ref": "ASTRA Solo Mode, Set Up"
        },
        {
          "id": "solo-deck",
          "text": "Shuffle the Starship cards into 3 piles, action side up; shuffle the A, B and C ASTRA Effect cards into one pile and stack the other 2 on top",
          "ref": "ASTRA Solo Mode, Set Up"
        }
      ]
    },
    {
      "id": "reminders",
      "title": "Easy to forget",
      "kind": "REMINDERS",
      "steps": [
        {
          "id": "ascending",
          "text": "Numbers in a zone must rise; gaps are fine, repeats are not",
          "ref": "Write Down a Number"
        },
        {
          "id": "must-write",
          "text": "If any of the 3 numbers fits you must take one; if none fits, cross off a System Error box",
          "ref": "Write Down a Number"
        },
        {
          "id": "reshuffle",
          "text": "When the piles run out, shuffle each discard pile separately into a new pile",
          "condition": {
            "minPlayers": 2
          },
          "ref": "Flip 3 Starship Cards"
        },
        {
          "id": "solo-give",
          "text": "Solo: use 2 of your 3 cards (one number, one action) and give the third to ASTRA",
          "condition": {
            "players": [
              1
            ]
          },
          "ref": "ASTRA Solo Mode, Game Turn"
        },
        {
          "id": "adventure-rules",
          "text": "Each Adventure's own rules override the standard rules",
          "ref": "Standard Rules"
        }
      ]
    },
    {
      "id": "start",
      "title": "Start playing",
      "kind": "START",
      "steps": [
        {
          "id": "flip",
          "text": "Everyone plays at once: flip the top card of each pile, action side up, beside it",
          "condition": {
            "minPlayers": 2
          },
          "ref": "Flip 3 Starship Cards"
        },
        {
          "id": "solo-draw",
          "text": "Draw 3 Starship cards (resolve an ASTRA Effect card at once and draw a replacement)",
          "condition": {
            "players": [
              1
            ]
          },
          "ref": "ASTRA Solo Mode, Game Turn"
        }
      ]
    }
  ]
}
