  "sections": [
    {
      "id": "scenario",
      "title": "Scenario & factions",
      "steps": [
        {
          "id": "scenario",
          "text": "Pick a {m} scenario from the Mission Book",
          "amounts": {
            "m": {
              "default": "Clash",
              "cases": [
                {
                  "when": {
                    "modules": [
                      "coop"
                    ]
                  },
                  "value": "Co-op"
                },
                {
                  "when": {
                    "modules": [
                      "campaign"
                    ]
                  },
                  "value": "solo campaign"
                }
              ]
            }
          },
          "note": "Tutorial: Brave New World (Mission Book p.7)",
          "ref": "p.7"
        },
        {
          "id": "faction",
          "text": "Choose a faction (core: Castle, Dungeon, Necropolis); on a tie the highest Resource die roll picks first",
          "ref": "p.7"
        },
        {
          "id": "hero",
          "text": "Choose one of your faction's Heroes as your Main Hero; a faction cube on level 1 of the Hero card",
          "ref": "p.7-8"
        },
        {
          "id": "components",
          "text": "Take your faction's Hero card, 2 Hero models, 7 Town Building tiles, Town board, 7 Unit cards, 3 Specialty cards and Ability card for your Hero, 20 cubes, Build, Population and Spell Book tokens",
          "ref": "p.7"
        },
        {
          "id": "x-tower",
          "text": "Tower: its faction components and Mission Book scenarios are available",
          "condition": {
            "modules": [
              "tower"
            ]
          },
          "ref": "Tower Mission Book"
        },
        {
          "id": "x-fortress",
          "text": "Fortress: its faction components and Mission Book scenarios are available",
          "condition": {
            "modules": [
              "fortress"
            ]
          },
          "ref": "Fortress Mission Book"
        },
        {
          "id": "x-rampart",
          "text": "Rampart: its faction components and Mission Book scenarios are available",
          "condition": {
            "modules": [
              "rampart"
            ]
          },
          "ref": "Rampart Mission Book"
        },
        {
          "id": "x-inferno",
          "text": "Inferno: its faction components and Mission Book scenarios are available",
          "condition": {
            "modules": [
              "inferno"
            ]
          },
          "ref": "Inferno Mission Book"
        },
        {
          "id": "x-stronghold",
          "text": "Stronghold: its faction components and Mission Book scenarios are available",
          "condition": {
            "modules": [
              "stronghold"
            ]
          },
          "ref": "Stronghold Mission Book"
        },
        {
          "id": "x-conflux",
          "text": "Conflux: its faction components and Mission Book scenarios are available",
          "condition": {
            "modules": [
              "conflux"
            ]
          },
          "ref": "Conflux Mission Book"
        },
        {
          "id": "x-cove",
          "text": "Cove: its faction components and Mission Book scenarios are available",
          "condition": {
            "modules": [
              "cove"
            ]
          },
          "ref": "Cove Mission Book"
        },
        {
          "id": "x-naval",
          "text": "Naval Battles: use its Mission Book scenarios and components",
          "condition": {
            "modules": [
              "naval"
            ]
          },
          "ref": "Naval Battles Mission Book"
        }
      ],
      "condition": {
        "notModules": [
          "bf-adventure",
          "bf-skirmish"
        ]
      }
    },
    {
      "id": "map",
      "title": "Map & town",
      "steps": [
        {
          "id": "map",
          "text": "Lay out the Map tiles for your player count as the Mission Book shows",
          "ref": "p.8"
        },
        {
          "id": "town",
          "text": "Town board in front of you, Building tiles beside it; place the buildings the scenario starts with",
          "ref": "p.8"
        },
        {
          "id": "income",
          "text": "Starting income from the scenario on the income tracker; Population, Build and Spell Book tokens on their spots",
          "ref": "p.8"
        },
        {
          "id": "resources",
          "text": "Resource tokens in piles; take the scenario's starting resources next to your Hero card",
          "ref": "p.8"
        },
        {
          "id": "tokens",
          "text": "All other tokens in piles within reach",
          "ref": "p.8"
        }
      ],
      "condition": {
        "notModules": [
          "bf-adventure",
          "bf-skirmish"
        ]
      }
    },
    {
      "id": "decks",
      "title": "Decks",
      "steps": [
        {
          "id": "stats",
          "text": "Statistic cards in 4 piles (Attack, Defense, Power, Knowledge); take the numbers shown on your Hero card as your starting deck",
          "ref": "p.8"
        },
        {
          "id": "arrow",
          "text": "Add Magic Arrow: 1 copy for a Might hero, 2 for a Magic hero",
          "ref": "p.8"
        },
        {
          "id": "specialty",
          "text": "Add your Hero's Ability card and Level 1 Specialty card; shuffle the deck facedown by your Hero card",
          "ref": "p.8"
        },
        {
          "id": "shared-decks",
          "text": "Ability, Artifact and Spell cards in 3 facedown decks; flip the top card of each beside it as its discard pile",
          "ref": "p.8"
        },
        {
          "id": "difficulty",
          "text": "Choose the starting difficulty and take its Starting Bonus(es)",
          "ref": "p.8, p.35"
        },
        {
          "id": "neutrals",
          "text": "Neutral Units in 4 shuffled decks by tier (Bronze, Silver, Gold, Azure), room for discards",
          "ref": "p.8"
        },
        {
          "id": "combat",
          "text": "Combat board next to the Map; set aside the starting units the scenario gives you",
          "ref": "p.8"
        },
        {
          "id": "round",
          "text": "Round tracker by the Map with a black cube on 1; shuffle the Astrologers Proclaim cards facedown beside it",
          "ref": "p.8"
        },
        {
          "id": "place-hero",
          "text": "Rotate your Starting tile as you like; Hero model on the field with the Town",
          "ref": "p.8"
        }
      ],
      "condition": {
        "notModules": [
          "bf-adventure",
          "bf-skirmish"
        ]
      }
    },
    {
      "id": "battlefield",
      "title": "Battlefield",
      "steps": [
        {
          "id": "bf-faction",
          "text": "Both players pick a faction: Hero card, Town board, 7 Unit cards and models, 3 Specialty cards, Ability card, 20 cubes",
          "condition": {
            "modules": [
              "bf-adventure"
            ]
          },
          "ref": "Battlefield p.4"
        },
        {
          "id": "sk-faction",
          "text": "Both players pick a faction: Hero card, 7 Unit cards and models, 3 Specialty cards, Ability card, 20 cubes",
          "condition": {
            "modules": [
              "bf-skirmish"
            ]
          },
          "ref": "Battlefield p.4"
        },
        {
          "id": "bf-decks",
          "text": "Prepare the Artifact, Spell and Ability decks; remove Diplomacy and Logistics",
          "ref": "Battlefield p.4",
          "condition": {
            "modules": [
              "bf-adventure"
            ]
          }
        },
        {
          "id": "sk-bf-decks",
          "text": "Prepare the Artifact, Spell and Ability decks; remove Diplomacy and Logistics",
          "ref": "Battlefield p.4",
          "condition": {
            "modules": [
              "bf-skirmish"
            ]
          }
        },
        {
          "id": "bf-tokens",
          "text": "Damage and Paralysis/Defense tokens in piles; Attack and Resource dice ready",
          "note": "Adventure mode also uses resource tokens and Treasure dice",
          "ref": "Battlefield p.4",
          "condition": {
            "modules": [
              "bf-adventure"
            ]
          }
        },
        {
          "id": "sk-bf-tokens",
          "text": "Damage and Paralysis/Defense tokens in piles; Attack and Resource dice ready",
          "note": "Adventure mode also uses resource tokens and Treasure dice",
          "ref": "Battlefield p.4",
          "condition": {
            "modules": [
              "bf-skirmish"
            ]
          }
        },
        {
          "id": "bf-round",
          "text": "Black cube on space 1 of the Round tracker",
          "condition": {
            "modules": [
              "bf-adventure"
            ]
          },
          "ref": "Battlefield p.4"
        },
        {
          "id": "bf-level",
          "text": "A faction cube on level 1 of your Hero card; build your starting deck of Might and Magic",
          "ref": "Battlefield p.4",
          "condition": {
            "modules": [
              "bf-adventure"
            ]
          }
        },
        {
          "id": "sk-bf-level",
          "text": "A faction cube on level 1 of your Hero card; build your starting deck of Might and Magic",
          "ref": "Battlefield p.4",
          "condition": {
            "modules": [
              "bf-skirmish"
            ]
          }
        },
        {
          "id": "bf-resources",
          "text": "Each player: 15 Gold, 3 Building Materials, 1 Valuable; income set to 10 Gold, 0, 0",
          "condition": {
            "modules": [
              "bf-adventure"
            ]
          },
          "ref": "Battlefield p.4"
        },
        {
          "id": "bf-board",
          "text": "Battlefield board between the players; Positive and Negative Morale decks; Obstacle and Initiative tokens",
          "ref": "Battlefield p.4",
          "condition": {
            "modules": [
              "bf-adventure"
            ]
          }
        },
        {
          "id": "sk-bf-board",
          "text": "Battlefield board between the players; Positive and Negative Morale decks; Obstacle and Initiative tokens",
          "ref": "Battlefield p.4",
          "condition": {
            "modules": [
              "bf-skirmish"
            ]
          }
        },
        {
          "id": "bf-adventure-deck",
          "text": "Prepare the Adventure deck",
          "condition": {
            "modules": [
              "bf-adventure"
            ]
          },
          "ref": "Battlefield p.4"
        }
      ]
    },
    {
      "id": "reminders",
      "title": "Easy to forget",
      "kind": "REMINDERS",
      "steps": [
        {
          "id": "rounds",
          "text": "Rounds alternate: Resource round (collect income), then Astrologers' round (draw a Proclaim card)",
          "ref": "p.8"
        },
        {
          "id": "tracker",
          "text": "Advance the black cube on the Round tracker after every player's turn",
          "ref": "p.8"
        }
      ],
      "condition": {
        "notModules": [
          "bf-adventure",
          "bf-skirmish"
        ]
      }
    },
    {
      "id": "start",
      "title": "Start playing",
      "kind": "START",
      "steps": [
        {
          "id": "first",
          "text": "Fastest to list 5 Neutral units from HoMM III goes first (or highest Attack die roll)",
          "ref": "p.8",
          "condition": {
            "notModules": [
              "bf-adventure",
              "bf-skirmish"
            ]
          }
        },
        {
          "id": "bf-first",
          "text": "Both players roll 2 Resource dice; highest goes first",
          "condition": {
            "modules": [
              "bf-adventure"
            ]
          },
          "ref": "Battlefield p.4"
        },
        {
          "id": "sk-first",
          "text": "Both players roll 2 Resource dice; highest goes first",
          "condition": {
            "modules": [
              "bf-skirmish"
            ]
          },
          "ref": "Battlefield p.4"
        }
      ]
    }
  ]
