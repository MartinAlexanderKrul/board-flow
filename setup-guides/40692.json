  "sections": [
    {
      "id": "setup",
      "title": "Setup",
      "steps": [
        {
          "id": "setup-1",
          "text": "Take the map for your player count; Game Turn marker on the first spot",
          "ref": "Setting up the game (p.2)"
        },
        {
          "id": "setup-2",
          "text": "Storage tray of Race tokens open beside the map",
          "ref": "Setting up the game (p.2)"
        },
        {
          "id": "setup-3",
          "text": "Shuffle the Race banners: 5 faceup in a column, the stack faceup below them",
          "ref": "Setting up the game (p.2)"
        },
        {
          "id": "setup-4",
          "text": "Shuffle the Special Power badges: one to the left of each banner, the stack beside the banner stack (6 combos visible)",
          "ref": "Setting up the game (p.2)"
        },
        {
          "id": "setup-5",
          "text": "A Lost Tribe token on every region with a Lost Tribe symbol; a Mountain token on every Mountain region",
          "ref": "Setting up the game (p.2)"
        },
        {
          "id": "setup-6",
          "text": "Each player takes five 1-value Victory coins; the rest form the stash",
          "ref": "Setting up the game (p.2)"
        }
      ]
    },
    {
      "id": "races",
      "title": "Races",
      "kind": "CHARACTERS",
      "steps": [
        {
          "id": "amazons",
          "text": "Amazons",
          "ref": "The Races p.9-10",
          "details": [
            "+4 tokens for conquest only: take 4 off the map after redeploying, back in hand when you ready troops"
          ]
        },
        {
          "id": "dwarves",
          "text": "Dwarves",
          "ref": "The Races p.9-10",
          "details": [
            "+1 coin per Mine region, even In Decline"
          ]
        },
        {
          "id": "elves",
          "text": "Elves",
          "ref": "The Races p.9-10",
          "details": [
            "Lose no tokens when a region is conquered: all come back to hand"
          ]
        },
        {
          "id": "ghouls",
          "text": "Ghouls",
          "ref": "The Races p.9-10",
          "details": [
            "All tokens stay when going In Decline",
            "In Decline they still conquer, at the start of your turn"
          ]
        },
        {
          "id": "giants",
          "text": "Giants",
          "ref": "The Races p.9-10",
          "details": [
            "Conquer next to a Mountain they hold with 1 token less (minimum 1)"
          ]
        },
        {
          "id": "halflings",
          "text": "Halflings",
          "ref": "The Races p.9-10",
          "details": [
            "Enter the map anywhere",
            "Holes-in-the-Ground in the first 2 regions conquered make them immune (until Decline or abandoned)"
          ]
        },
        {
          "id": "humans",
          "text": "Humans",
          "ref": "The Races p.9-10",
          "details": [
            "+1 coin per Farmland region"
          ]
        },
        {
          "id": "orcs",
          "text": "Orcs",
          "ref": "The Races p.9-10",
          "details": [
            "+1 coin per non-empty region conquered this turn"
          ]
        },
        {
          "id": "ratmen",
          "text": "Ratmen",
          "ref": "The Races p.9-10",
          "details": [
            "No power: lots of tokens"
          ]
        },
        {
          "id": "skeletons",
          "text": "Skeletons",
          "ref": "The Races p.9-10",
          "details": [
            "When redeploying: +1 token per 2 non-empty regions conquered this turn"
          ]
        },
        {
          "id": "sorcerers",
          "text": "Sorcerers",
          "ref": "The Races p.9-10",
          "details": [
            "Once per turn per opponent: replace a lone adjacent Active enemy token with one of yours from the tray"
          ]
        },
        {
          "id": "tritons",
          "text": "Tritons",
          "ref": "The Races p.9-10",
          "details": [
            "Conquer Coastal regions with 1 token less (minimum 1)"
          ]
        },
        {
          "id": "trolls",
          "text": "Trolls",
          "ref": "The Races p.9-10",
          "details": [
            "A Troll's Lair in each region: +1 defense, stays In Decline"
          ]
        },
        {
          "id": "wizards",
          "text": "Wizards",
          "ref": "The Races p.9-10",
          "details": [
            "+1 coin per Magic region"
          ]
        }
      ]
    },
