        },
        {
          "id": "flying",
          "text": "Flying",
          "ref": "Special Powers p.10-12",
          "details": [
            "Conquer any region except Seas and Lakes, adjacent or not"
          ]
        },
        {
          "id": "forest",
          "text": "Forest",
          "ref": "Special Powers p.10-12",
          "details": [
            "+1 coin per Forest region"
          ]
        },
        {
          "id": "fortified",
          "text": "Fortified",
          "ref": "Special Powers p.10-12",
          "details": [
            "Once per turn: a Fortress in one of your regions, +1 coin while Active and +1 defense (max 6)"
          ]
        },
        {
          "id": "heroic",
          "text": "Heroic",
          "ref": "Special Powers p.10-12",
          "details": [
            "End of turn: 2 Heroes make 2 of your regions immune"
          ]
        },
        {
          "id": "hill",
          "text": "Hill",
          "ref": "Special Powers p.10-12",
          "details": [
            "+1 coin per Hill region"
          ]
        },
        {
          "id": "merchant",
          "text": "Merchant",
          "ref": "Special Powers p.10-12",
          "details": [
            "+1 coin per region you occupy"
          ]
        },
        {
          "id": "mounted",
          "text": "Mounted",
          "ref": "Special Powers p.10-12",
          "details": [
            "Conquer Hill and Farmland regions with 1 token less (minimum 1)"
          ]
        },
        {
          "id": "pillaging",
          "text": "Pillaging",
          "ref": "Special Powers p.10-12",
          "details": [
            "+1 coin per non-empty region conquered this turn"
          ]
        },
        {
          "id": "seafaring",
          "text": "Seafaring",
          "ref": "Special Powers p.10-12",
          "details": [
            "Conquer the Seas and the Lake as empty regions and keep them In Decline"
          ]
        },
        {
          "id": "spirit",
          "text": "Spirit",
          "ref": "Special Powers p.10-12",
          "details": [
            "In Decline, does not count against the one-race-In-Decline limit and never leaves the map"
          ]
        },
        {
          "id": "stout",
          "text": "Stout",
          "ref": "Special Powers p.10-12",
          "details": [
            "Go In Decline right after a normal turn of conquests and scoring"
          ]
        },
        {
          "id": "swamp",
          "text": "Swamp",
          "ref": "Special Powers p.10-12",
          "details": [
            "+1 coin per Swamp region"
          ]
        },
        {
          "id": "underworld",
          "text": "Underworld",
          "ref": "Special Powers p.10-12",
          "details": [
            "Conquer Cavern regions with 1 token less; all Caverns are adjacent"
