    ]
  },
  "players": {
    "min": 2,
    "max": 6
  },
  "sections": [
    {
      "id": "supply",
      "title": "Basic supply",
      "steps": [
        {
          "id": "copper",
          "text": "Each player takes 7 Coppers; remaining Copper, all Silver and all Gold in faceup Supply piles",
          "ref": "p.3, p.9",
          "note": "5-6 players: add all the extra Copper, Silver and Gold from the Big Box"
        },
        {
          "id": "victory",
          "text": "Each player takes 3 Estates; {n} each of Estate and Duchy, {p} Provinces in the Supply; box the rest",
          "amounts": {
            "n": {
              "byPlayers": {
                "2": 8,
                "3": 12,
                "4": 12,
                "5": 12,
                "6": 12
              }
            },
            "p": {
              "byPlayers": {
                "2": 8,
                "3": 12,
                "4": 12,
                "5": 15,
                "6": 18
              }
            }
          },
          "ref": "p.3, p.9"
        },
        {
          "id": "curse",
          "text": "{n} Curse cards in the Supply; box the rest",
          "amounts": {
            "n": {
              "byPlayers": {
                "2": 10,
                "3": 20,
                "4": 30,
                "5": 40,
                "6": 50
              }
            }
          },
          "ref": "p.3, p.9"
        },
        {
          "id": "trash",
          "text": "Trash card to mark the trash pile",
          "ref": "p.3"
        }
      ]
    },
    {
      "id": "kingdom",
      "title": "Kingdom",
      "steps": [
        {
          "id": "choose",
          "text": "Choose 10 Kingdom cards (e.g. draw 10 Randomizers or a suggested set); 10 of each in faceup piles",
          "ref": "p.3",
          "note": "First game: Cellar, Market, Merchant, Militia, Mine, Moat, Remodel, Smithy, Village, Workshop"
        },
        {
          "id": "victory-kingdom",
          "text": "Kingdom Victory piles (e.g. Gardens) use {n} cards",
          "amounts": {
            "n": {
              "byPlayers": {
                "2": 8,
                "3": 12,
                "4": 12,
                "5": 12,
                "6": 12
              }
            }
          },
          "ref": "p.3"
        },
        {
          "id": "placeholders",
          "text": "Optional: Randomizers as placeholders under each pile; box unused Kingdom cards",
          "ref": "p.3"
        },
        {
          "id": "seaside-mats",
          "text": "Seaside: give out the Island, Native Village and Pirate Ship mats and the Embargo / coin tokens only if those cards are in the Kingdom",
          "condition": {
            "modules": [
              "seaside"
            ]
          },
          "ref": "Seaside rulebook"
        },
        {
          "id": "potion",
          "text": "Alchemy: add the Potion pile if any Kingdom card has a Potion in its cost",
          "condition": {
            "modules": [
              "alchemy"
            ]
          },
          "ref": "Alchemy p.2"
        },
        {
          "id": "colony",
          "text": "Prosperity: add Platinum and Colony ({n} Colonies) if all Kingdom cards are from Prosperity; with a mix, decide randomly (e.g. if the first Kingdom card dealt is from Prosperity)",
          "amounts": {
            "n": {
              "byPlayers": {
                "2": 8,
                "3": 12,
                "4": 12,
                "5": 12,
                "6": 12
              }
            }
          },
          "condition": {
            "modules": [
              "prosperity"
            ]
          },
          "ref": "Prosperity p.3"
        },
        {
          "id": "prosperity-tokens",
          "text": "Prosperity: Victory tokens and the Trade Route mat ready if cards use them",
          "condition": {
            "modules": [
              "prosperity"
            ]
          },
          "ref": "Prosperity rulebook"
        },
        {
          "id": "prizes",
          "text": "Cornucopia: with Tournament, set the 5 Prizes out as a pile; with Young Witch, add a Bane pile",
          "condition": {
            "modules": [
              "cornucopia"
            ]
          },
          "ref": "Cornucopia rulebook"
        },
        {
          "id": "dark-piles",
          "text": "Dark Ages: Ruins pile (mix of the five Ruins) and Knights pile (ten different Knights) are mixed piles; set out the Spoils pile when a card gains Spoils",
          "condition": {
            "modules": [
              "dark-ages"
            ]
          },
          "ref": "Dark Ages rulebook"
        },
        {
          "id": "coin-tokens",
          "text": "Guilds: Coin tokens in a supply",
          "condition": {
            "modules": [
              "guilds"
            ]
          },
          "ref": "Guilds rulebook"
        },
        {
          "id": "adventures",
          "text": "Adventures: each player takes a Tavern mat and their tokens; Events turned over while choosing Kingdom cards don't count toward the 10 (at most 2 recommended)",
          "condition": {
            "modules": [
              "adventures"
            ]
          },
          "ref": "Adventures rulebook"
        },
        {
          "id": "menagerie",
          "text": "Menagerie: set out the Horse pile; give each player an Exile mat if cards refer to Exile; Events and Ways are not Kingdom cards",
          "condition": {
            "modules": [
              "menagerie"
            ]
          },
          "ref": "Menagerie rulebook"
        }
      ]
    },
    {
      "id": "players",
      "title": "Players",
      "steps": [
        {
          "id": "deck",
          "text": "Shuffle your 7 Coppers + 3 Estates facedown as your deck",
          "ref": "p.4"
        },
        {
          "id": "hand",
          "text": "Draw {n} cards",
          "amounts": {
            "n": 5
          },
          "ref": "p.4"
        }
      ]
    },
    {
      "id": "reminders",
      "title": "Easy to forget",
      "kind": "REMINDERS",
      "steps": [
        {
          "id": "end",
          "text": "Game ends when the Provinces run out or any {n} Supply piles are empty",
          "ref": "p.6, p.9",
          "amounts": {
            "n": {
              "default": 3,
              "byPlayers": {
                "5": 4,
                "6": 4
              }
            }
          }
        },
        {
          "id": "tie",
          "text": "Ties go to the player with fewer turns",
          "ref": "p.6"
        }
      ]
    },
    {
      "id": "start",
      "title": "Start playing",
      "kind": "START",
      "steps": [
        {
          "id": "first",
          "text": "Random starting player (after a won game, the winner goes last); play is clockwise",
          "ref": "p.4"
        }
      ]
    }
